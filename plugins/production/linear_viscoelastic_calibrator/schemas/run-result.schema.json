    "status": {"enum": ["succeeded", "failed"]}, "attempts": {"type": "array", "items": {"type": "object"}}, "candidates": {"type": "array", "items": {"type": "object"}}, "recommendation": {"type": ["object", "null"]},
    "failure_code": {"type": ["string", "null"]}, "failure_detail": {"type": ["string", "null"]}, "recovery_hint": {"type": ["string", "null"]}
  }
}
