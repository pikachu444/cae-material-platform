{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cmp:schema:plugin-manifest:1.0.0",
  "title": "CMP Plugin Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "plugin_id",
    "display_name",
    "plugin_version",
    "package_digest",
    "contract_api",
    "extensions",
    "permissions",
    "resources",
    "non_production"
  ],
  "properties": {
    "manifest_version": {"const": "1.0"},
    "plugin_id": {"type": "string", "maxLength": 255, "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)+$"},
    "display_name": {"type": "string", "minLength": 1, "maxLength": 200},
    "plugin_version": {"type": "string", "maxLength": 64, "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "package_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "contract_api": {"type": "string", "minLength": 1, "maxLength": 100, "pattern": "^>=[0-9]+\\.[0-9]+ <[0-9]+\\.[0-9]+$"},
    "extensions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32767,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "entrypoint", "capabilities"],
        "properties": {
          "type": {
            "enum": [
              "importer",
              "processor",
              "statistical_analyzer",
              "material_model",
              "calibrator",
              "validator",
              "solver_exporter"
            ]
          },
          "entrypoint": {"type": "string", "minLength": 1, "maxLength": 500},
          "capabilities": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,99}$"}
          }
        }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network", "artifact_read_roles", "artifact_write_roles"],
      "properties": {
        "network": {"const": "none"},
        "artifact_read_roles": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 100}
        },
        "artifact_write_roles": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 100}
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu", "memory_mb", "gpu", "timeout_s"],
      "properties": {
        "cpu": {"type": "number", "exclusiveMinimum": 0, "maximum": 9999999.999, "multipleOf": 0.001},
        "memory_mb": {"type": "integer", "minimum": 64, "maximum": 2147483647},
        "gpu": {"type": "integer", "minimum": 0, "maximum": 2147483647},
        "timeout_s": {"type": "integer", "minimum": 1, "maximum": 2147483647}
      }
    },
    "non_production": {"const": true}
  }
}
