FROM python:3.12.14-slim-trixie@sha256:2c941e860699f878900b0edc2403613c234d4b32eda3cc9fa7036991a2a63c4a

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy \
    PATH=/app/.venv/bin:$PATH

RUN pip install --no-cache-dir "uv==0.12.5"

COPY pyproject.toml uv.lock README.md alembic.ini ./
COPY backend ./backend
COPY sdk ./sdk
COPY generated ./generated
COPY plugins ./plugins
# The demo seed runs inside this image and installs the exact source-v2
# application used by the issue-342 registration fixtures. Keep the image
# scoped to those two deterministic fixture trees rather than copying the
# repository's unrelated fixture archives.
COPY fixtures/schema-definition-bundle/source-v2 ./fixtures/schema-definition-bundle/source-v2
COPY fixtures/schema-record-data/source-v2-task1b ./fixtures/schema-record-data/source-v2-task1b
# The polymer Fit demo seed reads this bounded synthetic DMA reference to
# create the governed temperature-sweep input used by the TTS Process journey.
COPY fixtures/synthetic/dma-temperature-sweep-wlf-ui-v1.json ./fixtures/synthetic/dma-temperature-sweep-wlf-ui-v1.json

RUN uv sync --frozen --no-dev

# The long-running API/worker image never invokes Debian's Perl runtime. Remove
# this essential-for-package-management component after the final install so it
# cannot contribute a dormant runtime attack surface. This image is immutable;
# package installation belongs in the build above, not in a running container.
RUN rm -rf /root/.cache/uv \
    && dpkg --force-depends --force-remove-essential --remove perl-base

COPY scripts ./scripts

CMD ["cmp-api"]
