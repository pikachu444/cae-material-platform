FROM python:3.12-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy \
    PATH=/app/.venv/bin:$PATH

RUN pip install --no-cache-dir "uv>=0.9,<1"

COPY pyproject.toml uv.lock README.md alembic.ini ./
COPY backend ./backend
COPY sdk ./sdk
COPY generated ./generated
COPY plugins ./plugins

RUN uv sync --frozen --no-dev

# The long-running API/worker image never invokes Debian's Perl runtime. Remove
# this essential-for-package-management component after the final install so it
# cannot contribute a dormant runtime attack surface. This image is immutable;
# package installation belongs in the build above, not in a running container.
RUN rm -rf /root/.cache/uv \
    && dpkg --force-depends --force-remove-essential --remove perl-base

COPY scripts ./scripts

CMD ["cmp-api"]
