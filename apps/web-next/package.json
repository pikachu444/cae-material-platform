{
  "name": "@cmp/web-next",
  "private": true,
  "version": "0.1.0",
  "description": "Task-first prototype foundation for the CAE Material Platform reader.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174 --strictPort",
    "dev:prototype": "vite --mode prototype --host 127.0.0.1 --port 5174 --strictPort",
    "build": "tsc --noEmit && vite build",
    "build:prototype": "tsc --noEmit && vite build --mode prototype --outDir dist-prototype",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:prototype": "vitest run --mode prototype",
    "test:e2e": "playwright test",
    "storybook": "storybook dev --port 6007 --no-open",
    "build-storybook": "storybook build --output-dir storybook-static"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-tooltip": "1.2.16",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-table": "9.2.4",
    "lucide-react": "1.41.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "7.87.0",
    "react-router": "8.3.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@storybook/addon-a11y": "10.5.4",
    "@storybook/react-vite": "10.5.4",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "jsdom": "29.1.1",
    "storybook": "10.5.4",
    "typescript": "7.0.2",
    "vite": "8.1.4",
    "vitest": "4.1.10"
  }
}
