{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cmp:schema:audit:integrity:1.0.0",
  "title": "Audit Integrity Report 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "state", "event_count", "last_sequence_no", "segment_count",
    "sealed_through_sequence_no", "unsealed_event_count", "issues"
  ],
  "properties": {
    "state": {"type": "string", "enum": ["valid", "invalid"]},
    "event_count": {"type": "integer", "minimum": 0},
    "last_sequence_no": {"type": "integer", "minimum": 0},
    "segment_count": {"type": "integer", "minimum": 0},
    "sealed_through_sequence_no": {"type": "integer", "minimum": 0},
    "unsealed_event_count": {"type": "integer", "minimum": 0},
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "event_sequence_no", "segment_no"],
        "properties": {
          "code": {"type": "string", "minLength": 1, "maxLength": 100},
          "event_sequence_no": {"type": ["integer", "null"], "minimum": 1},
          "segment_no": {"type": ["integer", "null"], "minimum": 1}
        }
      }
    }
  }
}
