{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cmp:schema:audit:export:1.0.0",
  "title": "Audit Export Segment 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "export_version", "organization_id", "project_id", "from_sequence",
    "to_sequence", "anchor_previous_hash", "events", "segment_roots", "integrity"
  ],
  "properties": {
    "export_version": {"const": "1.0"},
    "organization_id": {"type": "string", "format": "uuid"},
    "project_id": {"type": "string", "format": "uuid"},
    "from_sequence": {"type": "integer", "minimum": 1},
    "to_sequence": {"type": "integer", "minimum": 1},
    "anchor_previous_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "events": {
      "type": "array",
      "maxItems": 10000,
      "items": {"$ref": "#/$defs/event"}
    },
    "segment_roots": {
      "type": "array",
      "items": {"$ref": "#/$defs/segment_root"}
    },
    "integrity": {"$ref": "#/$defs/integrity"}
  },
  "$defs": {
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": {"type": "string", "enum": ["user", "service"]},
        "id": {"type": "string", "format": "uuid"}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": {"type": "string", "minLength": 1, "maxLength": 150},
        "id": {"type": ["string", "null"], "format": "uuid"}
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id", "sequence_no", "occurred_at", "recorded_at", "actor",
        "organization_id", "project_id", "action", "target", "outcome",
        "request_id", "trace_id", "ip_or_client", "reason", "previous_hash",
        "event_hash"
      ],
      "properties": {
        "event_id": {"type": "string", "format": "uuid"},
        "sequence_no": {"type": "integer", "minimum": 1},
        "occurred_at": {"type": "string", "format": "date-time"},
        "recorded_at": {"type": "string", "format": "date-time"},
        "actor": {"$ref": "#/$defs/actor"},
        "organization_id": {"type": "string", "format": "uuid"},
        "project_id": {"type": "string", "format": "uuid"},
        "action": {
          "type": "string",
          "maxLength": 150,
          "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z0-9_-]+)+$"
        },
        "target": {"$ref": "#/$defs/target"},
        "outcome": {"type": "string", "enum": ["success", "failure", "denied"]},
        "request_id": {"type": "string", "format": "uuid"},
        "trace_id": {"type": "string", "minLength": 1, "maxLength": 255},
        "ip_or_client": {"const": "policy-redacted"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 2000},
        "previous_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "event_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state", "event_count", "last_sequence_no", "segment_count",
        "sealed_through_sequence_no", "unsealed_event_count", "issues"
      ],
      "properties": {
        "state": {"type": "string", "enum": ["valid", "invalid"]},
        "event_count": {"type": "integer", "minimum": 0},
        "last_sequence_no": {"type": "integer", "minimum": 0},
        "segment_count": {"type": "integer", "minimum": 0},
        "sealed_through_sequence_no": {"type": "integer", "minimum": 0},
        "unsealed_event_count": {"type": "integer", "minimum": 0},
        "issues": {"type": "array", "items": {"$ref": "#/$defs/integrity_issue"}}
      }
    },
    "integrity_issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "event_sequence_no", "segment_no"],
      "properties": {
        "code": {"type": "string", "minLength": 1, "maxLength": 100},
        "event_sequence_no": {"type": ["integer", "null"], "minimum": 1},
        "segment_no": {"type": ["integer", "null"], "minimum": 1}
      }
    },
    "segment_root": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segment_id", "segment_no", "first_sequence_no", "last_sequence_no",
        "event_count", "first_event_hash", "last_event_hash", "previous_root_hash",
        "root_hash", "created_at", "created_by", "request_id", "trace_id"
      ],
      "properties": {
        "segment_id": {"type": "string", "format": "uuid"},
        "segment_no": {"type": "integer", "minimum": 1},
        "first_sequence_no": {"type": "integer", "minimum": 1},
        "last_sequence_no": {"type": "integer", "minimum": 1},
        "event_count": {"type": "integer", "minimum": 1, "maximum": 10000},
        "first_event_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "last_event_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "previous_root_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "root_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "created_at": {"type": "string", "format": "date-time"},
        "created_by": {"type": "string", "format": "uuid"},
        "request_id": {"type": "string", "format": "uuid"},
        "trace_id": {"type": "string", "minLength": 1, "maxLength": 255}
      }
    }
  }
}
