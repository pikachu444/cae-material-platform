{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cmp:schema:job-resource:1.0.0",
  "title": "CMP Job Resource",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "job_id",
    "job_type",
    "state",
    "organization_id",
    "project_id",
    "classification",
    "submitted_at",
    "submitted_by",
    "deadline",
    "current_attempt",
    "result_manifest_id",
    "result_manifest_digest",
    "failure",
    "attempts",
    "links"
  ],
  "properties": {
    "job_id": {"type": "string", "format": "uuid"},
    "job_type": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,99}$"},
    "state": {
      "enum": [
        "planned",
        "needs_input",
        "queued",
        "claimed",
        "running",
        "waiting_external",
        "cancel_requested",
        "succeeded",
        "failed",
        "cancelled",
        "timed_out"
      ]
    },
    "organization_id": {"type": "string", "format": "uuid"},
    "project_id": {"type": "string", "format": "uuid"},
    "classification": {
      "enum": ["internal", "confidential", "restricted", "export_controlled"]
    },
    "submitted_at": {"type": "string", "format": "date-time"},
    "submitted_by": {"type": "string", "format": "uuid"},
    "deadline": {"type": "string", "format": "date-time"},
    "current_attempt": {"type": "integer", "minimum": 1},
    "result_manifest_id": {"type": ["string", "null"], "format": "uuid"},
    "result_manifest_digest": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "failure": {
      "anyOf": [{"$ref": "#/$defs/failure"}, {"type": "null"}]
    },
    "attempts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/attempt"}
    },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "required": ["self"],
      "properties": {"self": {"type": "string", "minLength": 1}}
    }
  },
  "$defs": {
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "code", "detail"],
      "properties": {
        "category": {
          "enum": [
            "transient_infrastructure",
            "resource_exhausted",
            "external_unavailable",
            "domain_invalid",
            "policy_denied",
            "output_invalid",
            "deadline_exceeded",
            "internal_error"
          ]
        },
        "code": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,99}$"},
        "detail": {"type": "string", "minLength": 1, "maxLength": 4000}
      }
    },
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fraction", "phase", "updated_at"],
      "properties": {
        "fraction": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "phase": {"type": ["string", "null"], "minLength": 1, "maxLength": 255},
        "updated_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt_id",
        "attempt_no",
        "state",
        "retry_kind",
        "retry_reason",
        "job_spec_digest",
        "runner_id",
        "claimed_at",
        "started_at",
        "ended_at",
        "progress",
        "result_manifest_id",
        "result_manifest_digest",
        "failure"
      ],
      "properties": {
        "attempt_id": {"type": "string", "format": "uuid"},
        "attempt_no": {"type": "integer", "minimum": 1},
        "state": {
          "enum": [
            "queued",
            "claimed",
            "running",
            "waiting_external",
            "succeeded",
            "failed",
            "cancelled",
            "timed_out"
          ]
        },
        "retry_kind": {"enum": ["initial", "automatic", "manual", "lease_recovery"]},
        "retry_reason": {"type": "string", "minLength": 1, "maxLength": 2000},
        "job_spec_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "runner_id": {"type": ["string", "null"], "format": "uuid"},
        "claimed_at": {"type": ["string", "null"], "format": "date-time"},
        "started_at": {"type": ["string", "null"], "format": "date-time"},
        "ended_at": {"type": ["string", "null"], "format": "date-time"},
        "progress": {
          "anyOf": [{"$ref": "#/$defs/progress"}, {"type": "null"}]
        },
        "result_manifest_id": {"type": ["string", "null"], "format": "uuid"},
        "result_manifest_digest": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "failure": {
          "anyOf": [{"$ref": "#/$defs/failure"}, {"type": "null"}]
        }
      }
    }
  }
}
