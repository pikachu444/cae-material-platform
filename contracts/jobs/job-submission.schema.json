{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cmp:schema:job-submission:1.0.0",
  "title": "CMP Job Submission",
  "type": "object",
  "additionalProperties": false,
  "required": ["job_type", "classification", "job_spec", "resource_policy"],
  "properties": {
    "job_type": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,99}$"},
    "classification": {
      "enum": ["internal", "confidential", "restricted", "export_controlled"]
    },
    "job_spec": {"$ref": "job-spec.schema.json"},
    "resource_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu_millis", "memory_mb", "gpu_count", "max_attempts"],
      "properties": {
        "cpu_millis": {"type": "integer", "minimum": 1, "maximum": 10000000},
        "memory_mb": {"type": "integer", "minimum": 1, "maximum": 100000000},
        "gpu_count": {"type": "integer", "minimum": 0, "maximum": 1024},
        "max_attempts": {"type": "integer", "minimum": 1, "maximum": 100}
      }
    },
    "priority": {
      "type": "integer",
      "minimum": -32768,
      "maximum": 32767,
      "default": 0
    }
  }
}
