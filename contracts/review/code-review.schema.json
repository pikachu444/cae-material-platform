{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cmp:schema:codex-code-review:v1",
  "title": "Independent Codex code review result",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "summary", "findings"],
  "properties": {
    "verdict": {
      "enum": ["PASS", "NEEDS_CHANGES"]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "severity",
          "category",
          "summary",
          "evidence",
          "required_action"
        ],
        "properties": {
          "severity": {
            "enum": ["blocking", "high", "medium", "low"]
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "line", "detail"],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "line": {
                "type": ["integer", "null"],
                "minimum": 1
              },
              "detail": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required_action": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
