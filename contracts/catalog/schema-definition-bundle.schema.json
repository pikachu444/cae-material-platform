{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cmp.example/contracts/catalog/schema-definition-bundle.schema.json",
  "title": "Catalog Schema Definition Bundle v1",
  "$defs": {
    "Uuid": {"type": "string", "format": "uuid"},
    "Sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "StableKey": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,62}[a-z0-9]$|^[a-z]$"
    },
    "SemVer": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "Classification": {
      "type": "string",
      "enum": ["internal", "confidential", "restricted", "export_controlled"]
    },
    "CommonUnitId": {
      "type": "string",
      "enum": ["Pa", "kPa", "MPa", "GPa", "m", "cm", "mm", "um", "s", "ms", "min", "h", "N", "kN", "kg", "g", "mg", "kg/m3", "g/cm3", "K", "Cel", "1", "%"]
    },
    "Definition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "name", "description"],
      "properties": {
        "key": {"$ref": "#/$defs/StableKey"},
        "name": {"type": "string", "minLength": 1, "maxLength": 200},
        "description": {"type": ["string", "null"], "minLength": 1, "maxLength": 4000}
      }
    },
    "ReferenceExtension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "link_key",
        "forward_label",
        "reverse_label",
        "source_cardinality",
        "target_cardinality"
      ],
      "properties": {
        "link_key": {"$ref": "#/$defs/StableKey"},
        "forward_label": {"type": "string", "minLength": 1, "maxLength": 200},
        "reverse_label": {"type": "string", "minLength": 1, "maxLength": 200},
        "source_cardinality": {"type": "string", "enum": ["one", "many"]},
        "target_cardinality": {"type": "string", "enum": ["one", "many"]},
        "source_table_key": {"$ref": "#/$defs/StableKey"},
        "target_table_key": {"$ref": "#/$defs/StableKey"},
        "reference_only": {"type": "boolean"}
      }
    },
    "CurveExtension": {
      "oneOf": [
        {"const": true},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["x_pointer", "y_pointer"],
          "properties": {
            "x_pointer": {"type": "string", "minLength": 1, "maxLength": 1000},
            "x_unit": {"$ref": "#/$defs/CommonUnitId"},
            "x_quantity": {"type": "string", "minLength": 1, "maxLength": 255},
            "x_scale": {"type": "string", "enum": ["linear", "log10"]},
            "y_pointer": {"type": "string", "minLength": 1, "maxLength": 1000},
            "y_unit": {"$ref": "#/$defs/CommonUnitId"},
            "y_quantity": {"type": "string", "minLength": 1, "maxLength": 255},
            "series_pointer": {"type": "string", "minLength": 1, "maxLength": 1000},
            "series_unit": {"$ref": "#/$defs/CommonUnitId"},
            "deviation_pointer": {"type": "string", "minLength": 1, "maxLength": 1000},
            "deviation_unit": {"$ref": "#/$defs/CommonUnitId"}
          }
        }
      ]
    },
    "SchemaType": {
      "oneOf": [
        {
          "type": "string",
          "enum": ["object", "string", "number", "integer", "boolean", "null"]
        },
        {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["string", "number", "integer", "boolean", "null"]
          },
          "contains": {"const": "null"}
        }
      ]
    },
    "SchemaNodeKeywords": {
      "type": "object",
      "properties": {
        "$defs": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/SchemaNode"}
        },
        "$ref": {"type": "string", "minLength": 1, "maxLength": 1000},
        "type": {"$ref": "#/$defs/SchemaType"},
        "title": {"type": "string", "minLength": 1, "maxLength": 200},
        "description": {"type": "string", "minLength": 1, "maxLength": 4000},
        "properties": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/SchemaNode"}
        },
        "required": {
          "type": "array",
          "items": {"type": "string", "minLength": 1, "maxLength": 200},
          "uniqueItems": true
        },
        "additionalProperties": {"const": false},
        "enum": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1, "maxLength": 255},
          "uniqueItems": true
        },
        "minimum": {"type": "number"},
        "maximum": {"type": "number"},
        "minLength": {"type": "integer", "minimum": 0},
        "maxLength": {"type": "integer", "minimum": 1},
        "pattern": {"type": "string", "minLength": 1, "maxLength": 500},
        "format": {"type": "string", "enum": ["date", "uuid"]},
        "x-business-key": {"const": true},
        "x-id-rule": {"type": "string", "minLength": 1, "maxLength": 1000},
        "x-reference": {"$ref": "#/$defs/ReferenceExtension"},
        "x-curve": {"$ref": "#/$defs/CurveExtension"},
        "x-unit": {"$ref": "#/$defs/CommonUnitId"},
        "x-quantity": {"type": "string", "minLength": 1, "maxLength": 255},
        "x-suggested-values": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1, "maxLength": 255},
          "uniqueItems": true
        },
        "x-indexed": {"type": "boolean"},
        "x-searchable": {"type": "boolean"},
        "x-source-origin": {"$ref": "#/$defs/SourceOrigin"}
      }
    },
    "SourceOrigin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_id", "schema_version", "file", "file_sha256", "pointer"],
      "properties": {
        "schema_id": {"type": "string", "minLength": 1, "maxLength": 500},
        "schema_version": {"type": "string", "minLength": 1, "maxLength": 64},
        "file": {"type": "string", "minLength": 1, "maxLength": 1000},
        "file_sha256": {"$ref": "#/$defs/Sha256"},
        "pointer": {"type": "string", "pattern": "^(/(?:[^/~]|~[01])*)+$"}
      }
    },
    "SchemaNode": {
      "allOf": [{"$ref": "#/$defs/SchemaNodeKeywords"}],
      "unevaluatedProperties": false
    },
    "RecordSchema": {
      "allOf": [
        {"$ref": "#/$defs/SchemaNodeKeywords"},
        {
          "type": "object",
          "required": ["$schema", "$id", "type", "properties", "additionalProperties"],
          "properties": {
            "$schema": {
              "const": "https://json-schema.org/draft/2020-12/schema"
            },
            "$id": {
              "type": "string",
              "pattern": "^urn:cmp:catalog-schema:(?:[a-z][a-z0-9_]{0,62}[a-z0-9]|[a-z]):(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
            },
            "type": {"const": "object"},
            "additionalProperties": {"const": false}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "RecordSchemaEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "name", "description", "schema_sha256", "schema"],
      "properties": {
        "key": {"$ref": "#/$defs/StableKey"},
        "name": {"type": "string", "minLength": 1, "maxLength": 200},
        "description": {"type": ["string", "null"], "minLength": 1, "maxLength": 4000},
        "schema_version": {"$ref": "#/$defs/SemVer"},
        "data_category": {
          "type": ["string", "null"],
          "enum": ["technical_data", "test_data", "simulation_data", null]
        },
        "schema_sha256": {"$ref": "#/$defs/Sha256"},
        "schema": {"$ref": "#/$defs/RecordSchema"}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "contract_version",
    "bundle_key",
    "bundle_version",
    "scope",
    "catalog",
    "record_schemas"
  ],
  "properties": {
    "$schema": {
      "const": "https://cmp.example/contracts/catalog/schema-definition-bundle.schema.json"
    },
    "contract_version": {"const": "1.0.0"},
    "bundle_key": {"$ref": "#/$defs/StableKey"},
    "bundle_version": {"$ref": "#/$defs/SemVer"},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["organization_id", "project_id", "classification"],
      "properties": {
        "organization_id": {"$ref": "#/$defs/Uuid"},
        "project_id": {"$ref": "#/$defs/Uuid"},
        "classification": {"$ref": "#/$defs/Classification"}
      }
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["database", "profile"],
      "properties": {
        "database": {"$ref": "#/$defs/Definition"},
        "profile": {"$ref": "#/$defs/Definition"}
      }
    },
    "record_schemas": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/RecordSchemaEntry"}
    },
    "unit_profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "name", "units"],
        "properties": {
          "key": {"$ref": "#/$defs/StableKey"},
          "name": {"type": "string", "minLength": 1, "maxLength": 200},
          "units": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {"$ref": "#/$defs/StableKey"},
            "additionalProperties": {"$ref": "#/$defs/CommonUnitId"}
          }
        }
      }
    }
  }
}
