{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cmp.example/contracts/catalog/catalog-resources.schema.json",
  "$defs": {
    "Uuid": {"type": "string", "format": "uuid"},
    "Sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "Classification": {
      "type": "string",
      "enum": ["internal", "confidential", "restricted", "export_controlled"]
    },
    "PropertySource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reference"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["manual", "supplier_datasheet", "test_derived", "literature", "calibration"]
        },
        "reference": {"type": ["string", "null"], "minLength": 1, "maxLength": 2000}
      }
    },
    "Applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "temperature_min_k",
        "temperature_max_k",
        "strain_rate_min_per_s",
        "strain_rate_max_per_s",
        "note"
      ],
      "properties": {
        "temperature_min_k": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "temperature_max_k": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "strain_rate_min_per_s": {"type": ["number", "null"], "minimum": 0},
        "strain_rate_max_per_s": {"type": ["number", "null"], "minimum": 0},
        "note": {"type": ["string", "null"], "minLength": 1, "maxLength": 2000}
      }
    },
    "MaterialContent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "material_code", "material_family", "description", "material_class"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 200},
        "material_code": {"type": ["string", "null"], "minLength": 1, "maxLength": 100},
        "material_family": {"type": ["string", "null"], "minLength": 1, "maxLength": 100},
        "description": {"type": ["string", "null"], "minLength": 1, "maxLength": 4000},
        "material_class": {"$ref": "#/$defs/MaterialClass"}
      }
    },
    "MaterialContentInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 200},
        "material_code": {"type": ["string", "null"], "minLength": 1, "maxLength": 100},
        "material_family": {"type": ["string", "null"], "minLength": 1, "maxLength": 100},
        "description": {"type": ["string", "null"], "minLength": 1, "maxLength": 4000},
        "material_class": {
          "anyOf": [
            {"$ref": "#/$defs/MaterialClass"},
            {"type": "null"}
          ]
        }
      }
    },
    "MaterialClass": {
      "type": "string",
      "enum": ["unclassified", "metal", "polymer", "elastomer", "composite", "ceramic", "other"]
    },
    "MaterialStateContent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "material_id",
        "material_revision_id",
        "name",
        "manufacturing_route",
        "heat_treatment",
        "lot_or_batch",
        "description"
      ],
      "properties": {
        "material_id": {"$ref": "#/$defs/Uuid"},
        "material_revision_id": {"$ref": "#/$defs/Uuid"},
        "name": {"type": "string", "minLength": 1, "maxLength": 200},
        "manufacturing_route": {"type": ["string", "null"], "minLength": 1, "maxLength": 500},
        "heat_treatment": {"type": ["string", "null"], "minLength": 1, "maxLength": 500},
        "lot_or_batch": {"type": ["string", "null"], "minLength": 1, "maxLength": 255},
        "description": {"type": ["string", "null"], "minLength": 1, "maxLength": 4000}
      }
    },
    "PropertySetContent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "material_state_id",
        "material_state_revision_id",
        "density_kg_per_m3",
        "density_source",
        "youngs_modulus_pa",
        "youngs_modulus_source",
        "poisson_ratio",
        "poisson_ratio_source",
        "yield_stress_pa",
        "yield_stress_source",
        "applicability"
      ],
      "properties": {
        "material_state_id": {"$ref": "#/$defs/Uuid"},
        "material_state_revision_id": {"$ref": "#/$defs/Uuid"},
        "density_kg_per_m3": {"type": "number", "exclusiveMinimum": 0},
        "density_source": {"$ref": "#/$defs/PropertySource"},
        "youngs_modulus_pa": {"type": "number", "exclusiveMinimum": 0},
        "youngs_modulus_source": {"$ref": "#/$defs/PropertySource"},
        "poisson_ratio": {"type": "number", "exclusiveMinimum": -1, "exclusiveMaximum": 0.5},
        "poisson_ratio_source": {"$ref": "#/$defs/PropertySource"},
        "yield_stress_pa": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "yield_stress_source": {"anyOf": [{"$ref": "#/$defs/PropertySource"}, {"type": "null"}]},
        "applicability": {"$ref": "#/$defs/Applicability"}
      }
    },
    "RevisionMetadata": {
      "type": "object",
      "required": [
        "id", "aggregate_id", "revision_no", "based_on_revision_id", "schema_id",
        "schema_version", "content_hash", "created_at", "created_by", "change_reason",
        "organization_id", "project_id", "classification", "lifecycle_state"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/Uuid"},
        "aggregate_id": {"$ref": "#/$defs/Uuid"},
        "revision_no": {"type": "integer", "minimum": 1},
        "based_on_revision_id": {"anyOf": [{"$ref": "#/$defs/Uuid"}, {"type": "null"}]},
        "schema_id": {"type": "string", "minLength": 1, "maxLength": 255},
        "schema_version": {"type": "string", "minLength": 1, "maxLength": 64},
        "content_hash": {"$ref": "#/$defs/Sha256"},
        "created_at": {"type": "string", "format": "date-time"},
        "created_by": {"$ref": "#/$defs/Uuid"},
        "change_reason": {"type": "string", "minLength": 1, "maxLength": 2000},
        "organization_id": {"$ref": "#/$defs/Uuid"},
        "project_id": {"$ref": "#/$defs/Uuid"},
        "classification": {"$ref": "#/$defs/Classification"},
        "lifecycle_state": {"type": "string", "const": "draft"}
      }
    },
    "ProvenanceSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity_type", "reference_type", "revision_id", "content_sha256",
        "based_on_revision_id", "recorded_at", "recorded_by"
      ],
      "properties": {
        "entity_type": {"type": "string", "minLength": 1, "maxLength": 100},
        "reference_type": {"type": "string", "minLength": 1, "maxLength": 100},
        "revision_id": {"$ref": "#/$defs/Uuid"},
        "content_sha256": {"$ref": "#/$defs/Sha256"},
        "based_on_revision_id": {"anyOf": [{"$ref": "#/$defs/Uuid"}, {"type": "null"}]},
        "recorded_at": {"type": "string", "format": "date-time"},
        "recorded_by": {"$ref": "#/$defs/Uuid"}
      }
    },
    "MaterialRevision": {
      "unevaluatedProperties": false,
      "allOf": [
        {"$ref": "#/$defs/RevisionMetadata"},
        {
          "type": "object",
          "required": ["content", "provenance"],
          "properties": {
            "content": {"$ref": "#/$defs/MaterialContent"},
            "provenance": {"$ref": "#/$defs/ProvenanceSummary"}
          }
        }
      ]
    },
    "MaterialStateRevision": {
      "unevaluatedProperties": false,
      "allOf": [
        {"$ref": "#/$defs/RevisionMetadata"},
        {
          "type": "object",
          "required": ["content", "provenance"],
          "properties": {
            "content": {"$ref": "#/$defs/MaterialStateContent"},
            "provenance": {"$ref": "#/$defs/ProvenanceSummary"}
          }
        }
      ]
    },
    "PropertySetRevision": {
      "unevaluatedProperties": false,
      "allOf": [
        {"$ref": "#/$defs/RevisionMetadata"},
        {
          "type": "object",
          "required": ["content", "provenance"],
          "properties": {
            "content": {"$ref": "#/$defs/PropertySetContent"},
            "provenance": {"$ref": "#/$defs/ProvenanceSummary"}
          }
        }
      ]
    },
    "MaterialResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["material_id", "current_revision", "links"],
      "properties": {
        "material_id": {"$ref": "#/$defs/Uuid"},
        "current_revision": {"$ref": "#/$defs/MaterialRevision"},
        "links": {
          "type": "object",
          "additionalProperties": false,
          "required": ["self", "revisions", "states"],
          "properties": {
            "self": {"type": "string"},
            "revisions": {"type": "string"},
            "states": {"type": "string"}
          }
        }
      }
    },
    "MaterialListResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "total_count"],
      "properties": {
        "items": {"type": "array", "items": {"$ref": "#/$defs/MaterialResponse"}},
        "total_count": {"type": "integer", "minimum": 0}
      }
    },
    "MaterialStateResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["material_state_id", "material_id", "current_revision", "property_sets_url"],
      "properties": {
        "material_state_id": {"$ref": "#/$defs/Uuid"},
        "material_id": {"$ref": "#/$defs/Uuid"},
        "current_revision": {"$ref": "#/$defs/MaterialStateRevision"},
        "property_sets_url": {"type": "string"}
      }
    },
    "PropertySetResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["property_set_id", "material_state_id", "current_revision"],
      "properties": {
        "property_set_id": {"$ref": "#/$defs/Uuid"},
        "material_state_id": {"$ref": "#/$defs/Uuid"},
        "current_revision": {"$ref": "#/$defs/PropertySetRevision"}
      }
    },
    "MaterialCreateRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "content", "change_reason"],
      "properties": {
        "classification": {"$ref": "#/$defs/Classification"},
        "content": {"$ref": "#/$defs/MaterialContentInput"},
        "change_reason": {"type": "string", "minLength": 1, "maxLength": 2000}
      }
    },
    "MaterialReviseRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content", "change_reason"],
      "properties": {
        "content": {"$ref": "#/$defs/MaterialContentInput"},
        "change_reason": {"type": "string", "minLength": 1, "maxLength": 2000}
      }
    },
    "MaterialStateCreateRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content", "change_reason"],
      "properties": {
        "content": {
          "type": "object",
          "additionalProperties": false,
          "required": ["material_revision_id", "name"],
          "properties": {
            "material_revision_id": {"$ref": "#/$defs/Uuid"},
            "name": {"type": "string", "minLength": 1, "maxLength": 200},
            "manufacturing_route": {"type": ["string", "null"], "minLength": 1, "maxLength": 500},
            "heat_treatment": {"type": ["string", "null"], "minLength": 1, "maxLength": 500},
            "lot_or_batch": {"type": ["string", "null"], "minLength": 1, "maxLength": 255},
            "description": {"type": ["string", "null"], "minLength": 1, "maxLength": 4000}
          }
        },
        "change_reason": {"type": "string", "minLength": 1, "maxLength": 2000}
      }
    },
    "PropertySetCreateRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content", "change_reason"],
      "properties": {
        "content": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "material_state_revision_id", "density_kg_per_m3", "density_source",
            "youngs_modulus_pa", "youngs_modulus_source", "poisson_ratio", "poisson_ratio_source"
          ],
          "properties": {
            "material_state_revision_id": {"$ref": "#/$defs/Uuid"},
            "density_kg_per_m3": {"type": "number", "exclusiveMinimum": 0},
            "density_source": {"$ref": "#/$defs/PropertySource"},
            "youngs_modulus_pa": {"type": "number", "exclusiveMinimum": 0},
            "youngs_modulus_source": {"$ref": "#/$defs/PropertySource"},
            "poisson_ratio": {"type": "number", "exclusiveMinimum": -1, "exclusiveMaximum": 0.5},
            "poisson_ratio_source": {"$ref": "#/$defs/PropertySource"},
            "yield_stress_pa": {"type": ["number", "null"], "exclusiveMinimum": 0},
            "yield_stress_source": {"anyOf": [{"$ref": "#/$defs/PropertySource"}, {"type": "null"}]},
            "applicability": {"$ref": "#/$defs/Applicability"}
          }
        },
        "change_reason": {"type": "string", "minLength": 1, "maxLength": 2000}
      }
    },
    "ProcessKind": {
      "type": "string",
      "enum": ["manufacturing", "heat_treatment", "conditioning", "other"]
    },
    "LotKind": {"type": "string", "enum": ["lot", "batch"]},
    "ProcessDefinitionContent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["process_code", "name", "kind", "description"],
      "properties": {
        "process_code": {"type": "string", "minLength": 1, "maxLength": 100},
        "name": {"type": "string", "minLength": 1, "maxLength": 200},
        "kind": {"$ref": "#/$defs/ProcessKind"},
        "description": {"type": ["string", "null"], "minLength": 1, "maxLength": 4000}
      }
    },
    "MaterialLotContent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "material_id", "material_revision_id", "lot_code", "kind",
        "manufacturer", "supplier", "description"
      ],
      "properties": {
        "material_id": {"$ref": "#/$defs/Uuid"},
        "material_revision_id": {"$ref": "#/$defs/Uuid"},
        "lot_code": {"type": "string", "minLength": 1, "maxLength": 100},
        "kind": {"$ref": "#/$defs/LotKind"},
        "manufacturer": {"type": ["string", "null"], "minLength": 1, "maxLength": 200},
        "supplier": {"type": ["string", "null"], "minLength": 1, "maxLength": 200},
        "description": {"type": ["string", "null"], "minLength": 1, "maxLength": 4000}
      }
    },
    "StateGenealogyContent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "material_state_id", "material_state_revision_id", "manufacturing_process_id",
        "manufacturing_process_revision_id", "heat_treatment_process_id",
        "heat_treatment_process_revision_id", "material_lot_id",
        "material_lot_revision_id", "note"
      ],
      "properties": {
        "material_state_id": {"$ref": "#/$defs/Uuid"},
        "material_state_revision_id": {"$ref": "#/$defs/Uuid"},
        "manufacturing_process_id": {"anyOf": [{"$ref": "#/$defs/Uuid"}, {"type": "null"}]},
        "manufacturing_process_revision_id": {"anyOf": [{"$ref": "#/$defs/Uuid"}, {"type": "null"}]},
        "heat_treatment_process_id": {"anyOf": [{"$ref": "#/$defs/Uuid"}, {"type": "null"}]},
        "heat_treatment_process_revision_id": {"anyOf": [{"$ref": "#/$defs/Uuid"}, {"type": "null"}]},
        "material_lot_id": {"anyOf": [{"$ref": "#/$defs/Uuid"}, {"type": "null"}]},
        "material_lot_revision_id": {"anyOf": [{"$ref": "#/$defs/Uuid"}, {"type": "null"}]},
        "note": {"type": ["string", "null"], "minLength": 1, "maxLength": 2000}
      }
    },
    "ProcessDefinitionRevision": {
      "unevaluatedProperties": false,
      "allOf": [
        {"$ref": "#/$defs/RevisionMetadata"},
        {"type": "object", "required": ["content", "provenance"], "properties": {
          "content": {"$ref": "#/$defs/ProcessDefinitionContent"},
          "provenance": {"$ref": "#/$defs/ProvenanceSummary"}
        }}
      ]
    },
    "MaterialLotRevision": {
      "unevaluatedProperties": false,
      "allOf": [
        {"$ref": "#/$defs/RevisionMetadata"},
        {"type": "object", "required": ["content", "provenance"], "properties": {
          "content": {"$ref": "#/$defs/MaterialLotContent"},
          "provenance": {"$ref": "#/$defs/ProvenanceSummary"}
        }}
      ]
    },
    "StateGenealogyRevision": {
      "unevaluatedProperties": false,
      "allOf": [
        {"$ref": "#/$defs/RevisionMetadata"},
        {"type": "object", "required": ["content", "provenance"], "properties": {
          "content": {"$ref": "#/$defs/StateGenealogyContent"},
          "provenance": {"$ref": "#/$defs/ProvenanceSummary"}
        }}
      ]
    },
    "ProcessDefinitionResponse": {
      "type": "object", "additionalProperties": false,
      "required": ["process_definition_id", "current_revision"],
      "properties": {
        "process_definition_id": {"$ref": "#/$defs/Uuid"},
        "current_revision": {"$ref": "#/$defs/ProcessDefinitionRevision"}
      }
    },
    "MaterialLotResponse": {
      "type": "object", "additionalProperties": false,
      "required": ["material_lot_id", "material_id", "current_revision"],
      "properties": {
        "material_lot_id": {"$ref": "#/$defs/Uuid"},
        "material_id": {"$ref": "#/$defs/Uuid"},
        "current_revision": {"$ref": "#/$defs/MaterialLotRevision"}
      }
    },
    "StateGenealogyResponse": {
      "type": "object", "additionalProperties": false,
      "required": ["state_genealogy_id", "material_state_id", "current_revision"],
      "properties": {
        "state_genealogy_id": {"$ref": "#/$defs/Uuid"},
        "material_state_id": {"$ref": "#/$defs/Uuid"},
        "current_revision": {"$ref": "#/$defs/StateGenealogyRevision"}
      }
    },
    "ProcessDefinitionCreateRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["classification", "content", "change_reason"],
      "properties": {
        "classification": {"$ref": "#/$defs/Classification"},
        "content": {
          "type": "object", "additionalProperties": false,
          "required": ["process_code", "name", "kind"],
          "properties": {
            "process_code": {"type": "string", "minLength": 1, "maxLength": 100},
            "name": {"type": "string", "minLength": 1, "maxLength": 200},
            "kind": {"$ref": "#/$defs/ProcessKind"},
            "description": {"type": ["string", "null"], "minLength": 1, "maxLength": 4000}
          }
        },
        "change_reason": {"type": "string", "minLength": 1, "maxLength": 2000}
      }
    },
    "ProcessDefinitionReviseRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["content", "change_reason"],
      "properties": {
        "content": {
          "type": "object", "additionalProperties": false,
          "required": ["process_code", "name", "kind"],
          "properties": {
            "process_code": {"type": "string", "minLength": 1, "maxLength": 100},
            "name": {"type": "string", "minLength": 1, "maxLength": 200},
            "kind": {"$ref": "#/$defs/ProcessKind"},
            "description": {"type": ["string", "null"], "minLength": 1, "maxLength": 4000}
          }
        },
        "change_reason": {"type": "string", "minLength": 1, "maxLength": 2000}
      }
    },
    "MaterialLotCreateRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["content", "change_reason"],
      "properties": {
        "content": {
          "type": "object", "additionalProperties": false,
          "required": ["material_revision_id", "lot_code", "kind"],
          "properties": {
            "material_revision_id": {"$ref": "#/$defs/Uuid"},
            "lot_code": {"type": "string", "minLength": 1, "maxLength": 100},
            "kind": {"$ref": "#/$defs/LotKind"},
            "manufacturer": {"type": ["string", "null"], "minLength": 1, "maxLength": 200},
            "supplier": {"type": ["string", "null"], "minLength": 1, "maxLength": 200},
            "description": {"type": ["string", "null"], "minLength": 1, "maxLength": 4000}
          }
        },
        "change_reason": {"type": "string", "minLength": 1, "maxLength": 2000}
      }
    },
    "StateGenealogyCreateRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["content", "change_reason"],
      "properties": {
        "content": {
          "type": "object", "additionalProperties": false,
          "required": ["material_state_revision_id"],
          "properties": {
            "material_state_revision_id": {"$ref": "#/$defs/Uuid"},
            "manufacturing_process_id": {"anyOf": [{"$ref": "#/$defs/Uuid"}, {"type": "null"}]},
            "manufacturing_process_revision_id": {"anyOf": [{"$ref": "#/$defs/Uuid"}, {"type": "null"}]},
            "heat_treatment_process_id": {"anyOf": [{"$ref": "#/$defs/Uuid"}, {"type": "null"}]},
            "heat_treatment_process_revision_id": {"anyOf": [{"$ref": "#/$defs/Uuid"}, {"type": "null"}]},
            "material_lot_id": {"anyOf": [{"$ref": "#/$defs/Uuid"}, {"type": "null"}]},
            "material_lot_revision_id": {"anyOf": [{"$ref": "#/$defs/Uuid"}, {"type": "null"}]},
            "note": {"type": ["string", "null"], "minLength": 1, "maxLength": 2000}
          }
        },
        "change_reason": {"type": "string", "minLength": 1, "maxLength": 2000}
      }
    },
    "BalanceBasis": {
      "type": "string",
      "enum": ["mass", "volume", "count", "not_assessed"]
    },
    "LotFlowInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "material_lot_id", "material_lot_revision_id", "original_quantity", "original_unit"
      ],
      "properties": {
        "material_lot_id": {"$ref": "#/$defs/Uuid"},
        "material_lot_revision_id": {"$ref": "#/$defs/Uuid"},
        "original_quantity": {
          "anyOf": [
            {"type": "number", "exclusiveMinimum": 0},
            {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?$"}
          ]
        },
        "original_unit": {
          "type": "string",
          "enum": ["kg", "g", "mg", "m3", "L", "mL", "cm3", "1"]
        }
      }
    },
    "LotFlowContent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "material_lot_id", "material_lot_revision_id", "original_quantity", "original_unit",
        "quantity_basis", "normalized_quantity", "normalized_unit", "normalization_factor"
      ],
      "properties": {
        "material_lot_id": {"$ref": "#/$defs/Uuid"},
        "material_lot_revision_id": {"$ref": "#/$defs/Uuid"},
        "original_quantity": {"type": "string"},
        "original_unit": {"type": "string"},
        "quantity_basis": {"type": "string", "enum": ["mass", "volume", "count"]},
        "normalized_quantity": {"type": "string"},
        "normalized_unit": {"type": "string", "enum": ["kg", "m3", "1"]},
        "normalization_factor": {"type": "string"}
      }
    },
    "ProcessBalance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_total", "output_total", "relative_difference", "within_tolerance"],
      "properties": {
        "input_total": {"type": "string"},
        "output_total": {"type": "string"},
        "relative_difference": {"type": "string"},
        "within_tolerance": {"const": true}
      }
    },
    "ProcessRunContent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "process_definition_id", "process_definition_revision_id", "material_state_id",
        "material_state_revision_id", "run_code", "started_at", "ended_at", "operator_name",
        "equipment_reference", "balance_basis", "balance_tolerance_fraction",
        "balance_not_assessed_reason", "balance", "inputs", "outputs", "note"
      ],
      "properties": {
        "process_definition_id": {"$ref": "#/$defs/Uuid"},
        "process_definition_revision_id": {"$ref": "#/$defs/Uuid"},
        "material_state_id": {"$ref": "#/$defs/Uuid"},
        "material_state_revision_id": {"$ref": "#/$defs/Uuid"},
        "run_code": {"type": "string", "minLength": 1, "maxLength": 100},
        "started_at": {"type": "string", "format": "date-time"},
        "ended_at": {"type": ["string", "null"], "format": "date-time"},
        "operator_name": {"type": ["string", "null"], "minLength": 1, "maxLength": 200},
        "equipment_reference": {"type": ["string", "null"], "minLength": 1, "maxLength": 255},
        "balance_basis": {"$ref": "#/$defs/BalanceBasis"},
        "balance_tolerance_fraction": {"type": ["string", "null"]},
        "balance_not_assessed_reason": {"type": ["string", "null"], "minLength": 1, "maxLength": 2000},
        "balance": {"anyOf": [{"$ref": "#/$defs/ProcessBalance"}, {"type": "null"}]},
        "inputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/LotFlowContent"}},
        "outputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/LotFlowContent"}},
        "note": {"type": ["string", "null"], "minLength": 1, "maxLength": 2000}
      }
    },
    "ProcessRunRevision": {
      "unevaluatedProperties": false,
      "allOf": [
        {"$ref": "#/$defs/RevisionMetadata"},
        {"type": "object", "required": ["content", "provenance"], "properties": {
          "content": {"$ref": "#/$defs/ProcessRunContent"},
          "provenance": {"$ref": "#/$defs/ProvenanceSummary"}
        }}
      ]
    },
    "ProcessRunResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["process_run_id", "material_state_id", "current_revision"],
      "properties": {
        "process_run_id": {"$ref": "#/$defs/Uuid"},
        "material_state_id": {"$ref": "#/$defs/Uuid"},
        "current_revision": {"$ref": "#/$defs/ProcessRunRevision"}
      }
    },
    "ProcessRunListResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items"],
      "properties": {
        "items": {"type": "array", "items": {"$ref": "#/$defs/ProcessRunResponse"}}
      }
    },
    "ProcessRunCreateRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content", "change_reason"],
      "properties": {
        "content": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "process_definition_id", "process_definition_revision_id",
            "material_state_revision_id", "run_code", "started_at", "balance_basis",
            "inputs", "outputs"
          ],
          "properties": {
            "process_definition_id": {"$ref": "#/$defs/Uuid"},
            "process_definition_revision_id": {"$ref": "#/$defs/Uuid"},
            "material_state_revision_id": {"$ref": "#/$defs/Uuid"},
            "run_code": {"type": "string", "minLength": 1, "maxLength": 100},
            "started_at": {"type": "string", "format": "date-time"},
            "ended_at": {"type": ["string", "null"], "format": "date-time"},
            "operator_name": {"type": ["string", "null"], "minLength": 1, "maxLength": 200},
            "equipment_reference": {"type": ["string", "null"], "minLength": 1, "maxLength": 255},
            "balance_basis": {"$ref": "#/$defs/BalanceBasis"},
            "balance_tolerance_fraction": {
              "anyOf": [
                {"type": "number", "minimum": 0, "maximum": 1},
                {"type": "string"},
                {"type": "null"}
              ]
            },
            "balance_not_assessed_reason": {"type": ["string", "null"], "minLength": 1, "maxLength": 2000},
            "inputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/LotFlowInput"}},
            "outputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/LotFlowInput"}},
            "note": {"type": ["string", "null"], "minLength": 1, "maxLength": 2000}
          }
        },
        "change_reason": {"type": "string", "minLength": 1, "maxLength": 2000}
      }
    },
    "CatalogProblem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "title", "status", "detail", "code", "trace_id"],
      "properties": {
        "type": {"type": "string", "minLength": 1, "maxLength": 255},
        "title": {"type": "string", "minLength": 1, "maxLength": 255},
        "status": {"type": "integer", "minimum": 400, "maximum": 599},
        "detail": {"type": "string", "minLength": 1, "maxLength": 2000},
        "code": {"type": "string", "pattern": "^CMP-CATALOG-[0-9]{4}$"},
        "trace_id": {"type": "string", "minLength": 1, "maxLength": 255}
      }
    }
  },
  "$ref": "#/$defs/MaterialResponse"
}
