{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cmp.example/contracts/catalog/schema-definition-bundle-application.schema.json",
  "title": "Applied Catalog Schema Definition Bundle v1",
  "$defs": {
    "Uuid": {"type": "string", "format": "uuid"},
    "Sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "StableKey": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,62}[a-z0-9]$|^[a-z]$"
    },
    "ApplyRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "artifact_sha256", "plan_fingerprint"],
      "properties": {
        "artifact_id": {"$ref": "#/$defs/Uuid"},
        "artifact_sha256": {"$ref": "#/$defs/Sha256"},
        "plan_fingerprint": {"$ref": "#/$defs/Sha256"},
        "delete_missing": {"const": false, "default": false}
      }
    },
    "SourceArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "organization_id",
        "project_id",
        "classification",
        "media_type",
        "size_bytes",
        "sha256"
      ],
      "properties": {
        "artifact_id": {"$ref": "#/$defs/Uuid"},
        "organization_id": {"$ref": "#/$defs/Uuid"},
        "project_id": {"$ref": "#/$defs/Uuid"},
        "classification": {
          "enum": ["internal", "confidential", "restricted", "export_controlled"]
        },
        "media_type": {"type": "string", "minLength": 1, "maxLength": 255},
        "size_bytes": {"type": "integer", "minimum": 0, "maximum": 67108864},
        "sha256": {"$ref": "#/$defs/Sha256"}
      }
    },
    "AppliedObject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "disposition",
        "target_type",
        "external_key",
        "parent_external_key",
        "aggregate_id",
        "revision_id",
        "content_hash",
        "published",
        "source_schema_id",
        "source_schema_version",
        "source_file",
        "source_file_sha256",
        "source_pointer"
      ],
      "properties": {
        "sequence": {"type": "integer", "minimum": 0},
        "disposition": {"enum": ["create", "update", "no-op"]},
        "target_type": {
          "enum": [
            "database",
            "profile",
            "table",
            "attribute",
            "layout",
            "profile_table_placement",
            "link_type"
          ]
        },
        "external_key": {"type": "string", "minLength": 1, "maxLength": 255},
        "parent_external_key": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 255
        },
        "aggregate_id": {
          "oneOf": [{"$ref": "#/$defs/Uuid"}, {"type": "null"}]
        },
        "revision_id": {
          "oneOf": [{"$ref": "#/$defs/Uuid"}, {"type": "null"}]
        },
        "content_hash": {"$ref": "#/$defs/Sha256"},
        "published": {"type": "boolean"},
        "source_schema_id": {"type": "string", "minLength": 1, "maxLength": 500},
        "source_schema_version": {"type": "string", "minLength": 1, "maxLength": 64},
        "source_file": {"type": ["string", "null"], "minLength": 1, "maxLength": 1000},
        "source_file_sha256": {
          "oneOf": [{"$ref": "#/$defs/Sha256"}, {"type": "null"}]
        },
        "source_pointer": {"type": "string", "pattern": "^(/(?:[^/~]|~[01])*)+$"}
      },
      "allOf": [
        {
          "if": {"properties": {"target_type": {"const": "profile_table_placement"}}},
          "then": {
            "properties": {
              "aggregate_id": {"type": "null"},
              "revision_id": {"type": "null"},
              "published": {"const": false}
            }
          },
          "else": {
            "properties": {
              "aggregate_id": {"$ref": "#/$defs/Uuid"},
              "revision_id": {"$ref": "#/$defs/Uuid"},
              "published": {"const": true}
            }
          }
        }
      ]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "contract_version",
    "application_id",
    "bundle_id",
    "bundle_key",
    "bundle_version",
    "classification",
    "source_artifact",
    "plan_fingerprint",
    "before_snapshot_fingerprint",
    "after_snapshot_fingerprint",
    "results",
    "mutations_applied",
    "delete_missing",
    "applied_at",
    "applied_by",
    "idempotency_key"
  ],
  "properties": {
    "$schema": {
      "const": "https://cmp.example/contracts/catalog/schema-definition-bundle-application.schema.json"
    },
    "contract_version": {"const": "1.0.0"},
    "application_id": {"$ref": "#/$defs/Uuid"},
    "bundle_id": {"$ref": "#/$defs/Uuid"},
    "bundle_key": {"$ref": "#/$defs/StableKey"},
    "bundle_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "classification": {
      "enum": ["internal", "confidential", "restricted", "export_controlled"]
    },
    "source_artifact": {"$ref": "#/$defs/SourceArtifact"},
    "plan_fingerprint": {"$ref": "#/$defs/Sha256"},
    "before_snapshot_fingerprint": {"$ref": "#/$defs/Sha256"},
    "after_snapshot_fingerprint": {"$ref": "#/$defs/Sha256"},
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/AppliedObject"}
    },
    "mutations_applied": {"type": "boolean"},
    "delete_missing": {"const": false},
    "applied_at": {"type": "string", "format": "date-time"},
    "applied_by": {"$ref": "#/$defs/Uuid"},
    "idempotency_key": {"type": "string", "pattern": "^[!-~]{1,255}$"}
  }
}
