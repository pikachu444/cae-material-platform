{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cmp.example/contracts/datasets/canonical-test-data.schema.json",
  "title": "CMP Canonical Test Data JSON",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_type",
    "schema_version",
    "document_id",
    "material",
    "test",
    "specimen",
    "conditions",
    "channels",
    "source"
  ],
  "properties": {
    "document_type": {"const": "cmp.test-data"},
    "schema_version": {"const": "1.0.0"},
    "document_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "material": {"$ref": "#/$defs/Material"},
    "test": {"$ref": "#/$defs/Test"},
    "specimen": {"$ref": "#/$defs/Specimen"},
    "conditions": {
      "type": "array",
      "maxItems": 128,
      "items": {"$ref": "#/$defs/Condition"}
    },
    "channels": {
      "type": "array",
      "minItems": 2,
      "maxItems": 512,
      "items": {"$ref": "#/$defs/Channel"}
    },
    "source": {"$ref": "#/$defs/Source"}
  },
  "$defs": {
    "Decimal": {
      "type": "string",
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$"
    },
    "Key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
    },
    "QuantitySemantics": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,159}$"
    },
    "Material": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maker", "grade", "lot_batch"],
      "properties": {
        "maker": {"type": "string", "minLength": 1, "maxLength": 200},
        "grade": {"type": "string", "minLength": 1, "maxLength": 200},
        "lot_batch": {"type": ["string", "null"], "minLength": 1, "maxLength": 200}
      }
    },
    "Test": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "operator",
        "laboratory",
        "method",
        "equipment_maker",
        "equipment_model"
      ],
      "properties": {
        "date": {"type": "string", "format": "date"},
        "operator": {"type": "string", "minLength": 1, "maxLength": 200},
        "laboratory": {"type": "string", "minLength": 1, "maxLength": 200},
        "method": {"type": "string", "minLength": 1, "maxLength": 300},
        "equipment_maker": {"type": ["string", "null"], "minLength": 1, "maxLength": 200},
        "equipment_model": {"type": ["string", "null"], "minLength": 1, "maxLength": 200}
      }
    },
    "Specimen": {
      "type": "object",
      "additionalProperties": false,
      "required": ["specimen_id", "description"],
      "properties": {
        "specimen_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "description": {"type": ["string", "null"], "minLength": 1, "maxLength": 1000}
      }
    },
    "Condition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "quantity_semantics",
        "original_value",
        "original_unit_string",
        "normalized_value",
        "normalized_unit"
      ],
      "properties": {
        "key": {"$ref": "#/$defs/Key"},
        "quantity_semantics": {"$ref": "#/$defs/QuantitySemantics"},
        "original_value": {"$ref": "#/$defs/Decimal"},
        "original_unit_string": {"type": "string", "minLength": 1, "maxLength": 64},
        "normalized_value": {"$ref": "#/$defs/Decimal"},
        "normalized_unit": {"type": "string", "minLength": 1, "maxLength": 64}
      }
    },
    "Normalization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scale", "offset"],
      "properties": {
        "scale": {"$ref": "#/$defs/Decimal"},
        "offset": {"$ref": "#/$defs/Decimal"}
      }
    },
    "Channel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "name",
        "quantity_semantics",
        "axis_role",
        "original_unit_string",
        "normalized_unit",
        "normalization",
        "original_values",
        "normalized_values",
        "missing_reasons"
      ],
      "properties": {
        "key": {"$ref": "#/$defs/Key"},
        "name": {"type": "string", "minLength": 1, "maxLength": 200},
        "quantity_semantics": {"$ref": "#/$defs/QuantitySemantics"},
        "axis_role": {"enum": ["independent", "dependent", "auxiliary"]},
        "original_unit_string": {"type": "string", "minLength": 1, "maxLength": 64},
        "normalized_unit": {"type": "string", "minLength": 1, "maxLength": 64},
        "normalization": {"$ref": "#/$defs/Normalization"},
        "original_values": {
          "type": "array",
          "minItems": 2,
          "maxItems": 1000000,
          "items": {"anyOf": [{"$ref": "#/$defs/Decimal"}, {"type": "null"}]}
        },
        "normalized_values": {
          "type": "array",
          "minItems": 2,
          "maxItems": 1000000,
          "items": {"anyOf": [{"$ref": "#/$defs/Decimal"}, {"type": "null"}]}
        },
        "missing_reasons": {
          "type": "array",
          "minItems": 2,
          "maxItems": 1000000,
          "items": {"type": ["string", "null"], "minLength": 1, "maxLength": 200}
        }
      }
    },
    "Source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_name", "media_type", "sha256"],
      "properties": {
        "file_name": {"type": "string", "minLength": 1, "maxLength": 255},
        "media_type": {"type": "string", "minLength": 1, "maxLength": 255},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
