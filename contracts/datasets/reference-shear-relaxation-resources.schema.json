{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cmp.example/contracts/datasets/reference-shear-relaxation-resources.schema.json",
  "$defs": {
    "Uuid": {"type": "string", "format": "uuid"},
    "Sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "RevisionMetadata": {
      "type": "object",
      "required": [
        "id", "aggregate_id", "revision_no", "based_on_revision_id", "schema_id",
        "schema_version", "content_hash", "created_at", "created_by", "change_reason",
        "organization_id", "project_id", "classification", "lifecycle_state"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/Uuid"},
        "aggregate_id": {"$ref": "#/$defs/Uuid"},
        "revision_no": {"type": "integer", "minimum": 1},
        "based_on_revision_id": {"type": ["string", "null"], "format": "uuid"},
        "schema_id": {"type": "string", "minLength": 1, "maxLength": 255},
        "schema_version": {"type": "string", "minLength": 1, "maxLength": 64},
        "content_hash": {"$ref": "#/$defs/Sha256"},
        "created_at": {"type": "string", "format": "date-time"},
        "created_by": {"$ref": "#/$defs/Uuid"},
        "change_reason": {"type": "string", "minLength": 1, "maxLength": 2000},
        "organization_id": {"$ref": "#/$defs/Uuid"},
        "project_id": {"$ref": "#/$defs/Uuid"},
        "classification": {"type": "string"},
        "lifecycle_state": {"const": "draft"}
      }
    },
    "Mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["time_column", "shear_modulus_column", "time_unit", "shear_modulus_unit"],
      "properties": {
        "time_column": {"type": "string", "minLength": 1, "maxLength": 255},
        "shear_modulus_column": {"type": "string", "minLength": 1, "maxLength": 255},
        "time_unit": {"enum": ["s", "ms", "min", "h"]},
        "shear_modulus_unit": {"enum": ["Pa", "kPa", "MPa", "GPa"]}
      }
    },
    "ImportRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "test_run_id", "test_run_revision_id", "raw_asset_id", "raw_artifact_id",
        "mapping", "change_reason"
      ],
      "properties": {
        "test_run_id": {"$ref": "#/$defs/Uuid"},
        "test_run_revision_id": {"$ref": "#/$defs/Uuid"},
        "raw_asset_id": {"$ref": "#/$defs/Uuid"},
        "raw_artifact_id": {"$ref": "#/$defs/Uuid"},
        "mapping": {"$ref": "#/$defs/Mapping"},
        "change_reason": {"type": "string", "minLength": 1, "maxLength": 2000}
      }
    },
    "Content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "material_state_id", "material_state_revision_id", "test_run_id",
        "test_run_revision_id", "raw_asset_id", "raw_artifact_id", "data_artifact_id",
        "data_sha256", "representation", "source_dataset_revision_id", "point_count",
        "time_column", "shear_modulus_column", "time_original_unit",
        "shear_modulus_original_unit", "normalized_time_unit",
        "normalized_shear_modulus_unit", "importer_id", "importer_version"
      ],
      "properties": {
        "material_state_id": {"$ref": "#/$defs/Uuid"},
        "material_state_revision_id": {"$ref": "#/$defs/Uuid"},
        "test_run_id": {"$ref": "#/$defs/Uuid"},
        "test_run_revision_id": {"$ref": "#/$defs/Uuid"},
        "raw_asset_id": {"$ref": "#/$defs/Uuid"},
        "raw_artifact_id": {"$ref": "#/$defs/Uuid"},
        "data_artifact_id": {"$ref": "#/$defs/Uuid"},
        "data_sha256": {"$ref": "#/$defs/Sha256"},
        "representation": {"enum": ["raw", "normalized"]},
        "source_dataset_revision_id": {"type": ["string", "null"], "format": "uuid"},
        "point_count": {"type": "integer", "minimum": 3, "maximum": 100000},
        "time_column": {"type": "string"},
        "shear_modulus_column": {"type": "string"},
        "time_original_unit": {"enum": ["s", "ms", "min", "h"]},
        "shear_modulus_original_unit": {"enum": ["Pa", "kPa", "MPa", "GPa"]},
        "normalized_time_unit": {"const": "s"},
        "normalized_shear_modulus_unit": {"const": "Pa"},
        "importer_id": {"const": "urn:cmp:datasets:reference-shear-relaxation-csv:1.0.0"},
        "importer_version": {"const": "1.0.0"}
      }
    },
    "Revision": {
      "type": "object",
      "unevaluatedProperties": false,
      "allOf": [
        {"$ref": "#/$defs/RevisionMetadata"},
        {"type": "object", "required": ["content"], "properties": {"content": {"$ref": "#/$defs/Content"}}}
      ]
    },
    "Response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset_id", "material_state_id", "current_revision", "links"],
      "properties": {
        "dataset_id": {"$ref": "#/$defs/Uuid"},
        "material_state_id": {"$ref": "#/$defs/Uuid"},
        "current_revision": {"$ref": "#/$defs/Revision"},
        "links": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "ListResponse": {
      "type": "object", "additionalProperties": false, "required": ["items"],
      "properties": {"items": {"type": "array", "items": {"$ref": "#/$defs/Response"}}}
    },
    "Point": {
      "type": "object", "additionalProperties": false,
      "required": ["time", "shear_modulus"],
      "properties": {"time": {"type": "number"}, "shear_modulus": {"type": "number"}}
    },
    "Preview": {
      "type": "object", "additionalProperties": false,
      "required": [
        "dataset_id", "dataset_revision_id", "representation", "point_count",
        "returned_point_count", "time_unit", "shear_modulus_unit", "points"
      ],
      "properties": {
        "dataset_id": {"$ref": "#/$defs/Uuid"},
        "dataset_revision_id": {"$ref": "#/$defs/Uuid"},
        "representation": {"enum": ["raw", "normalized"]},
        "point_count": {"type": "integer", "minimum": 3},
        "returned_point_count": {"type": "integer", "minimum": 3, "maximum": 10000},
        "time_unit": {"type": "string"},
        "shear_modulus_unit": {"type": "string"},
        "points": {"type": "array", "minItems": 3, "maxItems": 10000, "items": {"$ref": "#/$defs/Point"}}
      }
    }
  }
}
