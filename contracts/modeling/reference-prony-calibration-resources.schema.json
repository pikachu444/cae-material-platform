{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cmp.example/contracts/modeling/reference-prony-calibration-resources.schema.json",
  "$defs": {
    "Uuid": {"type": "string", "format": "uuid"},
    "Reason": {"type": "string", "minLength": 1, "maxLength": 2000},
    "ParameterPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lower", "initial", "upper"],
      "properties": {
        "lower": {"type": "number"},
        "initial": {"type": "number"},
        "upper": {"type": "number"}
      }
    },
    "PlanCreateRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan_label", "input_dataset_id", "input_dataset_revision_id", "baseline_model_id", "baseline_model_revision_id", "total_g_ratio", "fast_term_fraction", "fast_relaxation_time_s", "slow_relaxation_time_s", "normalization_modulus_pa", "change_reason"],
      "properties": {
        "classification": {"enum": ["internal", "confidential", "restricted", "export_controlled"]},
        "plan_label": {"type": "string", "minLength": 1, "maxLength": 160},
        "input_dataset_id": {"$ref": "#/$defs/Uuid"},
        "input_dataset_revision_id": {"$ref": "#/$defs/Uuid"},
        "baseline_model_id": {"$ref": "#/$defs/Uuid"},
        "baseline_model_revision_id": {"$ref": "#/$defs/Uuid"},
        "total_g_ratio": {"$ref": "#/$defs/ParameterPlan"},
        "fast_term_fraction": {"$ref": "#/$defs/ParameterPlan"},
        "fast_relaxation_time_s": {"$ref": "#/$defs/ParameterPlan"},
        "slow_relaxation_time_s": {"$ref": "#/$defs/ParameterPlan"},
        "normalization_modulus_pa": {"type": "number", "exclusiveMinimum": 0},
        "multistart_count": {"type": "integer", "minimum": 1, "maximum": 16},
        "random_seed": {"type": "integer", "minimum": 0},
        "maximum_function_evaluations": {"type": "integer", "minimum": 10, "maximum": 1000000},
        "ftol": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "xtol": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "gtol": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "change_reason": {"$ref": "#/$defs/Reason"}
      }
    },
    "ExecuteRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan_revision_id", "change_reason"],
      "properties": {
        "plan_revision_id": {"$ref": "#/$defs/Uuid"},
        "change_reason": {"$ref": "#/$defs/Reason"}
      }
    },
    "Candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prony_calibration_candidate_id", "attempt_ordinal", "status", "candidate_sha256", "total_g_ratio", "fast_term_fraction", "fast_g_ratio", "slow_g_ratio", "fast_relaxation_time_s", "slow_relaxation_time_s", "objective_total", "residual_root_mean_square_pa", "residual_mean_pa", "convergence_reason", "function_evaluations", "optimality", "parameter_at_bound", "identifiability_status", "uncertainty_status", "diagnostics_artifact_id", "diagnostics_point_count", "links"],
      "properties": {
        "prony_calibration_candidate_id": {"$ref": "#/$defs/Uuid"},
        "attempt_ordinal": {"type": "integer", "minimum": 1, "maximum": 16},
        "status": {"enum": ["converged", "nonconverged"]},
        "candidate_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "total_g_ratio": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "fast_term_fraction": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "fast_g_ratio": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "slow_g_ratio": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "fast_relaxation_time_s": {"type": "number", "exclusiveMinimum": 0},
        "slow_relaxation_time_s": {"type": "number", "exclusiveMinimum": 0},
        "objective_total": {"type": "number", "minimum": 0},
        "residual_root_mean_square_pa": {"type": "number", "minimum": 0},
        "residual_mean_pa": {"type": "number"},
        "convergence_reason": {"type": "string", "minLength": 1, "maxLength": 255},
        "function_evaluations": {"type": "integer", "minimum": 1},
        "optimality": {"type": "number", "minimum": 0},
        "parameter_at_bound": {"type": "boolean"},
        "identifiability_status": {"enum": ["full_rank", "rank_deficient"]},
        "uncertainty_status": {"const": "not_assessed_reference"},
        "diagnostics_artifact_id": {"$ref": "#/$defs/Uuid"},
        "diagnostics_point_count": {"type": "integer", "minimum": 5},
        "links": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "PlanResponse": {
      "type": "object",
      "required": ["prony_calibration_plan_id", "current_revision", "links"],
      "properties": {
        "prony_calibration_plan_id": {"$ref": "#/$defs/Uuid"},
        "current_revision": {"type": "object"},
        "links": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "RunResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prony_calibration_run_id", "status", "plan_id", "plan_revision_id", "input_dataset_id", "input_dataset_revision_id", "baseline_model_id", "baseline_model_revision_id", "environment_digest", "attempt_count", "candidate_count", "candidates", "links"],
      "properties": {
        "prony_calibration_run_id": {"$ref": "#/$defs/Uuid"},
        "status": {"const": "succeeded"},
        "plan_id": {"$ref": "#/$defs/Uuid"},
        "plan_revision_id": {"$ref": "#/$defs/Uuid"},
        "input_dataset_id": {"$ref": "#/$defs/Uuid"},
        "input_dataset_revision_id": {"$ref": "#/$defs/Uuid"},
        "baseline_model_id": {"$ref": "#/$defs/Uuid"},
        "baseline_model_revision_id": {"$ref": "#/$defs/Uuid"},
        "environment_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "attempt_count": {"type": "integer", "minimum": 1, "maximum": 16},
        "candidate_count": {"type": "integer", "minimum": 1, "maximum": 16},
        "candidates": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/Candidate"}},
        "links": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "DiagnosticsResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "points"],
      "properties": {
        "candidate_id": {"$ref": "#/$defs/Uuid"},
        "points": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["point_ordinal", "time_s", "observed_shear_modulus_pa", "predicted_shear_modulus_pa", "residual_pa"],
            "properties": {
              "point_ordinal": {"type": "integer", "minimum": 0},
              "time_s": {"type": "number", "minimum": 0},
              "observed_shear_modulus_pa": {"type": "number", "exclusiveMinimum": 0},
              "predicted_shear_modulus_pa": {"type": "number", "exclusiveMinimum": 0},
              "residual_pa": {"type": "number"}
            }
          }
        }
      }
    }
  }
}
