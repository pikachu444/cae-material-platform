{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cmp:schema:artifact-download-grant:1.0.0",
  "title": "Scoped Artifact Download Grant",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_id", "transfer_token", "expires_at", "transfer_path",
    "sha256", "size_bytes", "media_type"
  ],
  "properties": {
    "artifact_id": {"type": "string", "format": "uuid"},
    "transfer_token": {"type": "string", "minLength": 32, "maxLength": 4096},
    "expires_at": {"type": "string", "format": "date-time"},
    "transfer_path": {"type": "string", "minLength": 1, "maxLength": 2048},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "size_bytes": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
    "media_type": {"type": "string", "minLength": 1, "maxLength": 255}
  }
}
