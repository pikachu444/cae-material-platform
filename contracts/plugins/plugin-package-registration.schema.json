{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cmp:schema:plugin-package-registration:1.0.0",
  "title": "CMP Plugin Package Registration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "classification",
    "manifest",
    "package_artifact",
    "signature_artifact",
    "sbom_artifact",
    "schemas"
  ],
  "properties": {
    "classification": {
      "enum": ["internal", "confidential", "restricted", "export_controlled"]
    },
    "manifest": {"$ref": "plugin-manifest.schema.json"},
    "package_artifact": {"$ref": "#/$defs/artifactReference"},
    "signature_artifact": {"$ref": "#/$defs/artifactReference"},
    "sbom_artifact": {"$ref": "#/$defs/artifactReference"},
    "schemas": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {"$ref": "#/$defs/registeredSchema"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "sha256", "size_bytes", "media_type"],
      "properties": {
        "artifact_id": {"type": "string", "format": "uuid"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
        "media_type": {"type": "string", "minLength": 1, "maxLength": 255}
      }
    },
    "registeredSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_id", "extension_ordinal", "role", "document", "sha256"],
      "properties": {
        "schema_id": {"type": "string", "minLength": 1, "maxLength": 500},
        "extension_ordinal": {"type": "integer", "minimum": 1, "maximum": 32767},
        "role": {"enum": ["config", "input", "output", "evidence"]},
        "document": {"type": "object"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
