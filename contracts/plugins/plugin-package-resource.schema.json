{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cmp:schema:plugin-package-resource:1.0.0",
  "title": "CMP Plugin Package Resource",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "package_id",
    "definition_id",
    "organization_id",
    "project_id",
    "classification",
    "plugin_id",
    "display_name",
    "plugin_version",
    "package_digest",
    "manifest",
    "manifest_digest",
    "contract_api",
    "extensions",
    "network_policy",
    "artifact_read_roles",
    "artifact_write_roles",
    "resources",
    "package_artifact",
    "signature_artifact",
    "sbom_artifact",
    "schemas",
    "state",
    "activation_eligible",
    "active",
    "state_history",
    "submitted_at",
    "submitted_by",
    "submission_request_id",
    "submission_trace_id",
    "activation",
    "links"
  ],
  "properties": {
    "package_id": {"type": "string", "format": "uuid"},
    "definition_id": {"type": "string", "format": "uuid"},
    "organization_id": {"type": "string", "format": "uuid"},
    "project_id": {"type": "string", "format": "uuid"},
    "classification": {
      "enum": ["internal", "confidential", "restricted", "export_controlled"]
    },
    "plugin_id": {"type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)+$"},
    "display_name": {"type": "string", "minLength": 1, "maxLength": 200},
    "plugin_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "package_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "manifest": {"$ref": "plugin-manifest.schema.json"},
    "manifest_digest": {"$ref": "#/$defs/sha256"},
    "contract_api": {"type": "string", "minLength": 1, "maxLength": 100},
    "extensions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/extension"}
    },
    "network_policy": {"const": "none"},
    "artifact_read_roles": {
      "type": "array",
      "items": {"type": "string", "minLength": 1, "maxLength": 100}
    },
    "artifact_write_roles": {
      "type": "array",
      "items": {"type": "string", "minLength": 1, "maxLength": 100}
    },
    "resources": {"$ref": "#/$defs/resources"},
    "package_artifact": {"$ref": "#/$defs/artifactReference"},
    "signature_artifact": {"$ref": "#/$defs/artifactReference"},
    "sbom_artifact": {"$ref": "#/$defs/artifactReference"},
    "schemas": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/registeredSchema"}
    },
    "state": {"$ref": "#/$defs/packageState"},
    "activation_eligible": {"type": "boolean"},
    "active": {"type": "boolean"},
    "state_history": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/stateEvent"}
    },
    "submitted_at": {"type": "string", "format": "date-time"},
    "submitted_by": {"type": "string", "format": "uuid"},
    "submission_request_id": {"type": "string", "format": "uuid"},
    "submission_trace_id": {"type": "string", "minLength": 1, "maxLength": 255},
    "activation": {
      "anyOf": [{"$ref": "#/$defs/activation"}, {"type": "null"}]
    },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "required": ["self"],
      "properties": {"self": {"type": "string", "minLength": 1}}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "packageState": {
      "enum": ["contract_validated", "eligible", "rejected", "revoked", "unavailable"]
    },
    "artifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "sha256", "size_bytes", "media_type"],
      "properties": {
        "artifact_id": {"type": "string", "format": "uuid"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
        "media_type": {"type": "string", "minLength": 1, "maxLength": 255}
      }
    },
    "extension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinal", "type", "entrypoint", "capabilities"],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 1},
        "type": {
          "enum": [
            "importer",
            "processor",
            "statistical_analyzer",
            "material_model",
            "calibrator",
            "validator",
            "solver_exporter"
          ]
        },
        "entrypoint": {"type": "string", "minLength": 1, "maxLength": 500},
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,99}$"}
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu", "memory_mb", "gpu", "timeout_s"],
      "properties": {
        "cpu": {"type": "number", "exclusiveMinimum": 0, "maximum": 9999999.999, "multipleOf": 0.001},
        "memory_mb": {"type": "integer", "minimum": 64, "maximum": 2147483647},
        "gpu": {"type": "integer", "minimum": 0, "maximum": 2147483647},
        "timeout_s": {"type": "integer", "minimum": 1, "maximum": 2147483647}
      }
    },
    "registeredSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_id", "extension_ordinal", "role", "document", "sha256"],
      "properties": {
        "schema_id": {"type": "string", "minLength": 1, "maxLength": 500},
        "extension_ordinal": {"type": "integer", "minimum": 1},
        "role": {"enum": ["config", "input", "output", "evidence"]},
        "document": {"type": "object"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "stateEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "sequence_no",
        "from_state",
        "to_state",
        "occurred_at",
        "actor_id",
        "reason",
        "request_id",
        "trace_id"
      ],
      "properties": {
        "event_id": {"type": "string", "format": "uuid"},
        "sequence_no": {"type": "integer", "minimum": 1},
        "from_state": {
          "anyOf": [{"$ref": "#/$defs/packageState"}, {"type": "null"}]
        },
        "to_state": {"$ref": "#/$defs/packageState"},
        "occurred_at": {"type": "string", "format": "date-time"},
        "actor_id": {"type": "string", "format": "uuid"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 2000},
        "request_id": {"type": "string", "format": "uuid"},
        "trace_id": {"type": "string", "minLength": 1, "maxLength": 255}
      }
    },
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activation_id",
        "activated_at",
        "activated_by",
        "reason",
        "request_id",
        "trace_id"
      ],
      "properties": {
        "activation_id": {"type": "string", "format": "uuid"},
        "activated_at": {"type": "string", "format": "date-time"},
        "activated_by": {"type": "string", "format": "uuid"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 2000},
        "request_id": {"type": "string", "format": "uuid"},
        "trace_id": {"type": "string", "minLength": 1, "maxLength": 255}
      }
    }
  }
}
