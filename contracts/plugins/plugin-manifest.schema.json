{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cmp:schema:plugin-manifest:1.0.0",
  "title": "CMP Plugin Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "plugin_id",
    "display_name",
    "plugin_version",
    "package_digest",
    "contract_api",
    "extensions",
    "permissions",
    "resources",
    "non_production"
  ],
  "properties": {
    "manifest_version": {"const": "1.0"},
    "plugin_id": {"type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)+$"},
    "display_name": {"type": "string", "minLength": 1},
    "plugin_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "package_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "contract_api": {"type": "string", "minLength": 1},
    "extensions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "entrypoint", "capabilities"],
        "properties": {
          "type": {
            "enum": [
              "importer",
              "processor",
              "statistical_analyzer",
              "material_model",
              "calibrator",
              "validator",
              "solver_exporter"
            ]
          },
          "entrypoint": {"type": "string", "minLength": 1},
          "capabilities": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network", "artifact_read_roles", "artifact_write_roles"],
      "properties": {
        "network": {"const": "none"},
        "artifact_read_roles": {"type": "array", "items": {"type": "string"}},
        "artifact_write_roles": {"type": "array", "items": {"type": "string"}}
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu", "memory_mb", "gpu", "timeout_s"],
      "properties": {
        "cpu": {"type": "number", "exclusiveMinimum": 0},
        "memory_mb": {"type": "integer", "minimum": 64},
        "gpu": {"type": "integer", "minimum": 0},
        "timeout_s": {"type": "integer", "minimum": 1}
      }
    },
    "non_production": {"const": true}
  }
}

