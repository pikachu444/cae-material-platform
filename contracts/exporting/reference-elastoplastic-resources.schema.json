{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cmp.example/contracts/exporting/reference-elastoplastic-resources.schema.json",
  "$defs": {
    "Uuid": {"type": "string", "format": "uuid"},
    "Sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "MappingStatus": {
      "enum": ["exact", "transformed", "approximated", "ignored", "unsupported", "not_applicable"]
    },
    "Target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["solver", "version", "unit_system"],
      "properties": {
        "solver": {"enum": ["openradioss", "abaqus"]},
        "version": {"const": "2025"},
        "unit_system": {"const": "kg_m_s"}
      }
    },
    "MappingItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "ir_path", "target_representation", "status", "detail"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 80},
        "ir_path": {"type": "string", "pattern": "^/", "maxLength": 255},
        "target_representation": {"type": ["string", "null"], "maxLength": 300},
        "status": {"$ref": "#/$defs/MappingStatus"},
        "detail": {"type": "string", "minLength": 1, "maxLength": 1000}
      }
    },
    "MappingReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "material_model_id", "material_model_revision_id", "model_schema_digest", "target",
        "items", "exporter_id", "exporter_version", "exporter_digest",
        "mapping_report_sha256", "exportable", "non_production"
      ],
      "properties": {
        "material_model_id": {"$ref": "#/$defs/Uuid"},
        "material_model_revision_id": {"$ref": "#/$defs/Uuid"},
        "model_schema_digest": {"$ref": "#/$defs/Sha256"},
        "target": {"$ref": "#/$defs/Target"},
        "items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/MappingItem"}},
        "exporter_id": {"enum": ["cmp.reference.openradioss-law36", "cmp.reference.abaqus-isotropic-plasticity", "cmp.reference.unsupported"]},
        "exporter_version": {"type": "string"},
        "exporter_digest": {"$ref": "#/$defs/Sha256"},
        "mapping_report_sha256": {"$ref": "#/$defs/Sha256"},
        "exportable": {"type": "boolean"},
        "non_production": {"const": true}
      }
    },
    "PreflightRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["material_model_revision_id", "target"],
      "properties": {
        "material_model_revision_id": {"$ref": "#/$defs/Uuid"},
        "target": {"$ref": "#/$defs/Target"}
      }
    },
    "CardCreateRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "material_model_revision_id", "target", "expected_mapping_report_sha256",
        "solver_material_id", "material_name", "change_reason"
      ],
      "properties": {
        "material_model_revision_id": {"$ref": "#/$defs/Uuid"},
        "target": {"$ref": "#/$defs/Target"},
        "expected_mapping_report_sha256": {"$ref": "#/$defs/Sha256"},
        "solver_material_id": {"type": "integer", "minimum": 1, "maximum": 9999999999},
        "material_name": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$"},
        "change_reason": {"type": "string", "minLength": 1, "maxLength": 2000}
      }
    },
    "MappingStatuses": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "density", "isotropic_elasticity", "initial_yield", "isotropic_hardening_curve",
        "post_necking_extension", "temperature_dependence", "strain_rate_dependence", "unit_system"
      ],
      "properties": {
        "density": {"$ref": "#/$defs/MappingStatus"},
        "isotropic_elasticity": {"$ref": "#/$defs/MappingStatus"},
        "initial_yield": {"$ref": "#/$defs/MappingStatus"},
        "isotropic_hardening_curve": {"$ref": "#/$defs/MappingStatus"},
        "post_necking_extension": {"$ref": "#/$defs/MappingStatus"},
        "temperature_dependence": {"$ref": "#/$defs/MappingStatus"},
        "strain_rate_dependence": {"$ref": "#/$defs/MappingStatus"},
        "unit_system": {"$ref": "#/$defs/MappingStatus"}
      }
    },
    "Applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "temperature_min_k", "temperature_max_k", "strain_rate_min_per_s",
        "strain_rate_max_per_s", "note"
      ],
      "properties": {
        "temperature_min_k": {"type": ["number", "null"], "minimum": 0},
        "temperature_max_k": {"type": ["number", "null"], "minimum": 0},
        "strain_rate_min_per_s": {"type": ["number", "null"], "minimum": 0},
        "strain_rate_max_per_s": {"type": ["number", "null"], "minimum": 0},
        "note": {"type": ["string", "null"], "minLength": 1, "maxLength": 2000}
      }
    },
    "CardContent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "material_model_id", "material_model_revision_id", "model_schema_digest", "target", "solver_material_id",
        "material_name", "density_kg_per_m3", "youngs_modulus_pa", "poisson_ratio",
        "initial_yield_stress_pa", "hardening_curve_artifact_id", "hardening_curve_sha256",
        "hardening_curve_point_count", "extension_max_true_plastic_strain",
        "post_necking_extension_policy", "applicability", "mapping_statuses", "mapping_report_sha256",
        "card_sha256", "exporter_id", "exporter_version", "exporter_digest", "non_production"
      ],
      "properties": {
        "material_model_id": {"$ref": "#/$defs/Uuid"},
        "material_model_revision_id": {"$ref": "#/$defs/Uuid"},
        "model_schema_digest": {"$ref": "#/$defs/Sha256"},
        "target": {"$ref": "#/$defs/Target"},
        "solver_material_id": {"type": "integer", "minimum": 1, "maximum": 9999999999},
        "material_name": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$"},
        "density_kg_per_m3": {"type": "number", "exclusiveMinimum": 0},
        "youngs_modulus_pa": {"type": "number", "exclusiveMinimum": 0},
        "poisson_ratio": {"type": "number", "exclusiveMinimum": -1, "exclusiveMaximum": 0.5},
        "initial_yield_stress_pa": {"type": "number", "exclusiveMinimum": 0},
        "hardening_curve_artifact_id": {"$ref": "#/$defs/Uuid"},
        "hardening_curve_sha256": {"$ref": "#/$defs/Sha256"},
        "hardening_curve_point_count": {"type": "integer", "minimum": 2, "maximum": 5000},
        "extension_max_true_plastic_strain": {"type": "number", "exclusiveMinimum": 0},
        "post_necking_extension_policy": {"const": "approved_constant_true_stress"},
        "applicability": {"$ref": "#/$defs/Applicability"},
        "mapping_statuses": {"$ref": "#/$defs/MappingStatuses"},
        "mapping_report_sha256": {"$ref": "#/$defs/Sha256"},
        "card_sha256": {"$ref": "#/$defs/Sha256"},
        "exporter_id": {"enum": ["cmp.reference.openradioss-law36", "cmp.reference.abaqus-isotropic-plasticity"]},
        "exporter_version": {"const": "1.0.0"},
        "exporter_digest": {"$ref": "#/$defs/Sha256"},
        "non_production": {"const": true}
      }
    },
    "RevisionMetadata": {
      "type": "object",
      "required": [
        "id", "aggregate_id", "revision_no", "based_on_revision_id", "schema_id",
        "schema_version", "content_hash", "created_at", "created_by", "change_reason",
        "organization_id", "project_id", "classification", "lifecycle_state"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/Uuid"},
        "aggregate_id": {"$ref": "#/$defs/Uuid"},
        "revision_no": {"type": "integer", "minimum": 1},
        "based_on_revision_id": {"type": ["string", "null"], "format": "uuid"},
        "schema_id": {"type": "string", "minLength": 1, "maxLength": 255},
        "schema_version": {"type": "string", "minLength": 1, "maxLength": 64},
        "content_hash": {"$ref": "#/$defs/Sha256"},
        "created_at": {"type": "string", "format": "date-time"},
        "created_by": {"$ref": "#/$defs/Uuid"},
        "change_reason": {"type": "string", "minLength": 1, "maxLength": 2000},
        "organization_id": {"$ref": "#/$defs/Uuid"},
        "project_id": {"$ref": "#/$defs/Uuid"},
        "classification": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$"},
        "lifecycle_state": {"const": "draft"}
      }
    },
    "ProvenanceSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity_type", "reference_type", "revision_id", "content_sha256",
        "based_on_revision_id", "source_material_model_revision_id",
        "source_hardening_curve_artifact_id", "source_hardening_curve_sha256",
        "mapping_report_sha256", "recorded_at", "recorded_by"
      ],
      "properties": {
        "entity_type": {"const": "exporting.solver_card.revision"},
        "reference_type": {"const": "exporting.solver_card.revision"},
        "revision_id": {"$ref": "#/$defs/Uuid"},
        "content_sha256": {"$ref": "#/$defs/Sha256"},
        "based_on_revision_id": {"type": ["string", "null"], "format": "uuid"},
        "source_material_model_revision_id": {"$ref": "#/$defs/Uuid"},
        "source_hardening_curve_artifact_id": {"$ref": "#/$defs/Uuid"},
        "source_hardening_curve_sha256": {"$ref": "#/$defs/Sha256"},
        "mapping_report_sha256": {"$ref": "#/$defs/Sha256"},
        "recorded_at": {"type": "string", "format": "date-time"},
        "recorded_by": {"$ref": "#/$defs/Uuid"}
      }
    },
    "CardRevision": {
      "unevaluatedProperties": false,
      "allOf": [
        {"$ref": "#/$defs/RevisionMetadata"},
        {
          "type": "object",
          "required": ["content", "provenance"],
          "properties": {
            "content": {"$ref": "#/$defs/CardContent"},
            "provenance": {"$ref": "#/$defs/ProvenanceSummary"}
          }
        }
      ]
    },
    "CardResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "solver_card_id", "material_model_id", "target", "solver_material_id",
        "material_name", "current_revision", "links"
      ],
      "properties": {
        "solver_card_id": {"$ref": "#/$defs/Uuid"},
        "material_model_id": {"$ref": "#/$defs/Uuid"},
        "target": {"$ref": "#/$defs/Target"},
        "solver_material_id": {"type": "integer"},
        "material_name": {"type": "string"},
        "current_revision": {"$ref": "#/$defs/CardRevision"},
        "links": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "CardListResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items"],
      "properties": {"items": {"type": "array", "items": {"$ref": "#/$defs/CardResponse"}}}
    },
    "CardCreatedResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["card", "mapping_report"],
      "properties": {
        "card": {"$ref": "#/$defs/CardResponse"},
        "mapping_report": {"$ref": "#/$defs/MappingReport"}
      }
    },
    "Exporter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exporter_id", "exporter_version", "exporter_digest", "solver", "version", "unit_system", "keywords"],
      "properties": {
        "exporter_id": {"type": "string"},
        "exporter_version": {"const": "1.0.0"},
        "exporter_digest": {"$ref": "#/$defs/Sha256"},
        "solver": {"enum": ["openradioss", "abaqus"]},
        "version": {"const": "2025"},
        "unit_system": {"const": "kg_m_s"},
        "keywords": {"type": "array", "minItems": 2, "items": {"type": "string"}}
      }
    },
    "Capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_family_id", "model_schema_version", "model_schema_digest", "exporters", "mapping_statuses", "non_production"],
      "properties": {
        "model_family_id": {"const": "urn:cmp:reference:isotropic-tabulated-plasticity:1.0.0"},
        "model_schema_version": {"const": "1.0.0"},
        "model_schema_digest": {"$ref": "#/$defs/Sha256"},
        "exporters": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/Exporter"}},
        "mapping_statuses": {"type": "array", "items": {"$ref": "#/$defs/MappingStatus"}},
        "non_production": {"const": true}
      }
    },
    "ExportProblem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "title", "status", "detail", "code", "trace_id"],
      "properties": {
        "type": {"const": "urn:cmp:problem:exporting:elastoplastic"},
        "title": {"type": "string", "minLength": 1},
        "status": {"type": "integer", "minimum": 400, "maximum": 599},
        "detail": {"type": "string", "minLength": 1, "maxLength": 2000},
        "code": {"type": "string", "pattern": "^CMP-EXPORT-[0-9]{4}$"},
        "trace_id": {"type": "string", "minLength": 1}
      }
    }
  }
}
