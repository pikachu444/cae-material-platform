{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cmp.example/contracts/exporting/bulk-export-resources.schema.json",
  "$defs": {
    "Uuid": {"type": "string", "format": "uuid"},
    "Sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "Classification": {"enum": ["internal", "confidential", "restricted", "export_controlled"]},
    "MemberKind": {"enum": ["raw_original", "dataset_parquet", "dataset_csv", "model_ir_json", "model_ir_schema", "solver_mapping_report", "solver_card_native"]},
    "SourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "raw_asset_id", "artifact_id", "dataset_id", "dataset_revision_id", "material_model_id", "material_model_revision_id", "solver_card_id", "solver_card_revision_id"],
      "properties": {
        "kind": {"$ref": "#/$defs/MemberKind"},
        "raw_asset_id": {"oneOf": [{"$ref": "#/$defs/Uuid"}, {"type": "null"}]},
        "artifact_id": {"oneOf": [{"$ref": "#/$defs/Uuid"}, {"type": "null"}]},
        "dataset_id": {"oneOf": [{"$ref": "#/$defs/Uuid"}, {"type": "null"}]},
        "dataset_revision_id": {"oneOf": [{"$ref": "#/$defs/Uuid"}, {"type": "null"}]},
        "material_model_id": {"oneOf": [{"$ref": "#/$defs/Uuid"}, {"type": "null"}]},
        "material_model_revision_id": {"oneOf": [{"$ref": "#/$defs/Uuid"}, {"type": "null"}]},
        "solver_card_id": {"oneOf": [{"$ref": "#/$defs/Uuid"}, {"type": "null"}]},
        "solver_card_revision_id": {"oneOf": [{"$ref": "#/$defs/Uuid"}, {"type": "null"}]}
      }
    },
    "Candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "classification", "source_sha256", "source_size_bytes", "media_type", "default_archive_path", "label"],
      "properties": {
        "source": {"$ref": "#/$defs/SourceRef"}, "classification": {"$ref": "#/$defs/Classification"},
        "source_sha256": {"$ref": "#/$defs/Sha256"}, "source_size_bytes": {"type": "integer", "minimum": 0, "maximum": 5368709120},
        "media_type": {"type": "string", "minLength": 1, "maxLength": 255},
        "default_archive_path": {"type": "string", "minLength": 1, "maxLength": 512}, "label": {"type": "string", "minLength": 1, "maxLength": 255}
      }
    },
    "CandidateList": {"type": "object", "additionalProperties": false, "required": ["items"], "properties": {"items": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/Candidate"}}}},
    "RequestedMember": {
      "type": "object", "additionalProperties": false, "required": ["ordinal", "source", "required", "archive_path"],
      "properties": {"ordinal": {"type": "integer", "minimum": 1, "maximum": 1000}, "source": {"$ref": "#/$defs/SourceRef"}, "required": {"type": "boolean"}, "archive_path": {"type": ["string", "null"], "minLength": 1, "maxLength": 512}}
    },
    "CreateSelectionRequest": {
      "type": "object", "additionalProperties": false, "required": ["classification", "selection_label", "members", "change_reason"],
      "properties": {"classification": {"$ref": "#/$defs/Classification"}, "selection_label": {"type": "string", "minLength": 1, "maxLength": 160}, "members": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {"$ref": "#/$defs/RequestedMember"}}, "change_reason": {"type": "string", "minLength": 1, "maxLength": 2000}}
    },
    "SelectionResponse": {"type": "object", "required": ["export_selection_id", "current_revision", "links"], "properties": {"export_selection_id": {"$ref": "#/$defs/Uuid"}, "current_revision": {"type": "object"}, "links": {"type": "object"}}},
    "CreateJobRequest": {"type": "object", "additionalProperties": false, "required": ["export_selection_id"], "properties": {"export_selection_id": {"$ref": "#/$defs/Uuid"}}},
    "JobResponse": {
      "type": "object", "additionalProperties": false,
      "required": ["export_job_id", "classification", "export_selection_id", "export_selection_revision_id", "state", "attempt_count", "bundle_id", "failure_code", "failure_detail", "submitted_at", "submitted_by", "started_at", "completed_at", "links"],
      "properties": {"export_job_id": {"$ref": "#/$defs/Uuid"}, "classification": {"$ref": "#/$defs/Classification"}, "export_selection_id": {"$ref": "#/$defs/Uuid"}, "export_selection_revision_id": {"$ref": "#/$defs/Uuid"}, "state": {"enum": ["queued", "running", "succeeded", "failed"]}, "attempt_count": {"type": "integer", "minimum": 1}, "bundle_id": {"oneOf": [{"$ref": "#/$defs/Uuid"}, {"type": "null"}]}, "failure_code": {"type": ["string", "null"]}, "failure_detail": {"type": ["string", "null"]}, "submitted_at": {"type": "string", "format": "date-time"}, "submitted_by": {"$ref": "#/$defs/Uuid"}, "started_at": {"type": ["string", "null"], "format": "date-time"}, "completed_at": {"type": ["string", "null"], "format": "date-time"}, "links": {"type": "object"}}
    },
    "BundleResponse": {
      "type": "object", "additionalProperties": false,
      "required": ["export_bundle_id", "classification", "export_selection_id", "export_selection_revision_id", "archive_artifact_id", "archive_sha256", "archive_size_bytes", "manifest_sha256", "component_count", "omission_count", "created_at", "created_by", "links"],
      "properties": {"export_bundle_id": {"$ref": "#/$defs/Uuid"}, "classification": {"$ref": "#/$defs/Classification"}, "export_selection_id": {"$ref": "#/$defs/Uuid"}, "export_selection_revision_id": {"$ref": "#/$defs/Uuid"}, "archive_artifact_id": {"$ref": "#/$defs/Uuid"}, "archive_sha256": {"$ref": "#/$defs/Sha256"}, "archive_size_bytes": {"type": "integer", "minimum": 1, "maximum": 5368709120}, "manifest_sha256": {"$ref": "#/$defs/Sha256"}, "component_count": {"type": "integer", "minimum": 1, "maximum": 1000}, "omission_count": {"type": "integer", "minimum": 0, "maximum": 999}, "created_at": {"type": "string", "format": "date-time"}, "created_by": {"$ref": "#/$defs/Uuid"}, "links": {"type": "object"}}
    },
    "BundleList": {"type": "object", "additionalProperties": false, "required": ["items"], "properties": {"items": {"type": "array", "items": {"$ref": "#/$defs/BundleResponse"}}}},
    "DownloadAuthorization": {"type": "object", "additionalProperties": false, "required": ["artifact_id", "transfer_url", "transfer_token", "expires_at", "sha256", "size_bytes", "media_type"], "properties": {"artifact_id": {"$ref": "#/$defs/Uuid"}, "transfer_url": {"type": "string"}, "transfer_token": {"type": "string", "minLength": 32, "maxLength": 4096}, "expires_at": {"type": "string", "format": "date-time"}, "sha256": {"$ref": "#/$defs/Sha256"}, "size_bytes": {"type": "integer", "minimum": 1}, "media_type": {"const": "application/zip"}}}
  }
}
