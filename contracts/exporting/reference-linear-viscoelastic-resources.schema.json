{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cmp.example/contracts/exporting/reference-linear-viscoelastic-resources.schema.json",
  "$defs": {
    "Uuid": {"type": "string", "format": "uuid"},
    "Sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "MappingStatus": {"enum": ["exact", "transformed", "approximated", "ignored", "unsupported", "not_applicable"]},
    "Target": {
      "type": "object", "additionalProperties": false,
      "required": ["solver", "version", "unit_system"],
      "properties": {"solver": {"const": "abaqus"}, "version": {"const": "2025"}, "unit_system": {"const": "kg_m_s"}}
    },
    "MappingItem": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "ir_path", "target_representation", "status", "detail"],
      "properties": {
        "name": {"type": "string"}, "ir_path": {"type": "string", "pattern": "^/"},
        "target_representation": {"type": ["string", "null"]},
        "status": {"$ref": "#/$defs/MappingStatus"}, "detail": {"type": "string"}
      }
    },
    "MappingReport": {
      "type": "object", "additionalProperties": false,
      "required": ["material_model_id", "material_model_revision_id", "model_schema_digest", "target", "items", "exporter_id", "exporter_version", "exporter_digest", "mapping_report_sha256", "exportable", "non_production"],
      "properties": {
        "material_model_id": {"$ref": "#/$defs/Uuid"}, "material_model_revision_id": {"$ref": "#/$defs/Uuid"},
        "model_schema_digest": {"$ref": "#/$defs/Sha256"}, "target": {"$ref": "#/$defs/Target"},
        "items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/MappingItem"}},
        "exporter_id": {"enum": ["cmp.reference.abaqus-linear-prony", "cmp.reference.unsupported"]},
        "exporter_version": {"type": "string"}, "exporter_digest": {"$ref": "#/$defs/Sha256"},
        "mapping_report_sha256": {"$ref": "#/$defs/Sha256"}, "exportable": {"type": "boolean"}, "non_production": {"const": true}
      }
    },
    "PreflightRequest": {
      "type": "object", "additionalProperties": false, "required": ["material_model_revision_id", "target"],
      "properties": {"material_model_revision_id": {"$ref": "#/$defs/Uuid"}, "target": {"$ref": "#/$defs/Target"}}
    },
    "CardCreateRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["material_model_revision_id", "target", "expected_mapping_report_sha256", "solver_material_id", "material_name", "change_reason"],
      "properties": {
        "material_model_revision_id": {"$ref": "#/$defs/Uuid"}, "target": {"$ref": "#/$defs/Target"},
        "expected_mapping_report_sha256": {"$ref": "#/$defs/Sha256"},
        "solver_material_id": {"type": "integer", "minimum": 1, "maximum": 9999999999},
        "material_name": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$"},
        "change_reason": {"type": "string", "minLength": 1, "maxLength": 2000}
      }
    },
    "Term": {
      "type": "object", "additionalProperties": false, "required": ["ordinal", "g_ratio", "k_ratio", "relaxation_time_s"],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 1, "maximum": 5}, "g_ratio": {"type": "number", "minimum": 0, "exclusiveMaximum": 1},
        "k_ratio": {"type": "number", "minimum": 0, "exclusiveMaximum": 1}, "relaxation_time_s": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "CardContent": {
      "type": "object", "additionalProperties": false,
      "required": ["material_model_id", "material_model_revision_id", "model_schema_digest", "target", "solver_material_id", "material_name", "density_kg_per_m3", "youngs_modulus_pa", "poisson_ratio", "bulk_relaxation_status", "terms", "mapping_statuses", "mapping_report_sha256", "card_sha256", "exporter_id", "exporter_version", "exporter_digest", "non_production"],
      "properties": {
        "material_model_id": {"$ref": "#/$defs/Uuid"}, "material_model_revision_id": {"$ref": "#/$defs/Uuid"}, "model_schema_digest": {"$ref": "#/$defs/Sha256"},
        "target": {"$ref": "#/$defs/Target"}, "solver_material_id": {"type": "integer"}, "material_name": {"type": "string"},
        "density_kg_per_m3": {"type": "number", "exclusiveMinimum": 0}, "youngs_modulus_pa": {"type": "number", "exclusiveMinimum": 0}, "poisson_ratio": {"type": "number"},
        "bulk_relaxation_status": {"enum": ["characterized", "not_characterized"]}, "terms": {"type": "array", "minItems": 1, "maxItems": 5, "items": {"$ref": "#/$defs/Term"}},
        "mapping_statuses": {"type": "object", "additionalProperties": {"$ref": "#/$defs/MappingStatus"}}, "mapping_report_sha256": {"$ref": "#/$defs/Sha256"},
        "card_sha256": {"$ref": "#/$defs/Sha256"}, "exporter_id": {"const": "cmp.reference.abaqus-linear-prony"}, "exporter_version": {"const": "1.0.0"},
        "exporter_digest": {"$ref": "#/$defs/Sha256"}, "non_production": {"const": true}
      }
    },
    "CardResponse": {
      "type": "object", "additionalProperties": false,
      "required": ["solver_card_id", "material_model_id", "target", "solver_material_id", "material_name", "current_revision", "links"],
      "properties": {
        "solver_card_id": {"$ref": "#/$defs/Uuid"}, "material_model_id": {"$ref": "#/$defs/Uuid"}, "target": {"$ref": "#/$defs/Target"},
        "solver_material_id": {"type": "integer"}, "material_name": {"type": "string"},
        "current_revision": {"type": "object", "required": ["id", "content", "provenance"], "properties": {"id": {"$ref": "#/$defs/Uuid"}, "content": {"$ref": "#/$defs/CardContent"}, "provenance": {"type": "object"}}},
        "links": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "CardListResponse": {"type": "object", "required": ["items"], "properties": {"items": {"type": "array", "items": {"$ref": "#/$defs/CardResponse"}}}},
    "CardCreatedResponse": {"type": "object", "required": ["card", "mapping_report"], "properties": {"card": {"$ref": "#/$defs/CardResponse"}, "mapping_report": {"$ref": "#/$defs/MappingReport"}}},
    "Capabilities": {"type": "object"}
  }
}
